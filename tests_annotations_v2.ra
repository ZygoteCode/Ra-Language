// ===== Annotations v2: param annotations, @-nested, @inherited, @sealed =====

print("=== 1. Parameter annotations on top-level fn ===");
@target("parameter")
annotation Validated(min: int = 0, max: int = 100) {}

fn enroll(@Validated(min = 1, max = 99) age: int): int {
    ret age;
}
enroll(50);

print(has_annotation("param:enroll.age", "Validated"));            // true
print(annotation_arg("param:enroll.age", "Validated", "min"));      // 1
print(annotation_arg("param:enroll.age", "Validated", "max"));      // 99


print("=== 2. Parameter annotations on class methods ===");
@target("parameter")
annotation NotNull() {}

pub class Service {
    pub fn process(@NotNull data: string, @Validated(max = 10) count: int): string {
        ret data;
    }
}
var s = Service();
s.process("hi", 5);

print(has_annotation("param:Service.process.data", "NotNull"));     // true
print(has_annotation("param:Service.process.count", "Validated"));  // true
print(annotation_arg("param:Service.process.count", "Validated", "max")); // 10


print("=== 3. @-nested expressions: @composes(@A(args), @B) ===");
annotation Tracing(level: int = 1) {}
annotation Metrics() {}

@composes(@Tracing(level = 5), @Metrics)
annotation Observed() {}

@Observed()
fn critical_op() => print("critical");
critical_op();

print(has_annotation("fn:critical_op", "Observed"));                // true
print(has_annotation("fn:critical_op", "Tracing"));                 // true
print(has_annotation("fn:critical_op", "Metrics"));                 // true
print(annotation_arg("fn:critical_op", "Tracing", "level"));        // 5


print("=== 4. @inherited propagation on class methods ===");
@inherited
annotation Auth(role: string = "user") {}

pub class Controller {
    @Auth(role = "admin")
    pub fn delete(): string { ret "deleted"; }
}

pub class AdminController : Controller {
    pub fn other(): string { ret "other"; }
}

var ac = AdminController();
print(has_annotation("method:AdminController.delete", "Auth"));     // true (inherited)
print(annotation_arg("method:AdminController.delete", "Auth", "role")); // admin


print("=== 5. @inherited on class itself ===");
@inherited
annotation Module(name: string = "core") {}

@Module(name = "billing")
pub class BillingBase {
    pub fn op(): int { ret 1; }
}

pub class BillingPro : BillingBase {
    pub fn op2(): int { ret 2; }
}

print(has_annotation("class:BillingPro", "Module"));                // true (inherited)
print(annotation_arg("class:BillingPro", "Module", "name"));        // billing


print("=== 6. Non-inherited annotation does NOT propagate ===");
annotation Local(tag: string = "x") {}

@Local(tag = "owner-only")
pub class LocalBase {
    pub fn op(): int { ret 1; }
}

pub class LocalSub : LocalBase {
    pub fn op2(): int { ret 2; }
}
print(has_annotation("class:LocalSub", "Local"));                   // false


print("=== 7. @sealed prevents override of base method ===");
@sealed
annotation Frozen() {}

pub class Lockable {
    @Frozen()
    pub fn unlock(): string { ret "open"; }
}

fn try_subclass(): string {
    try {
        pub class BadChild : Lockable {
            override pub fn unlock(): string { ret "hacked"; }
        }
        ret "ALLOWED-BUG";
    } catch (e) {
        ret "BLOCKED";
    }
}
print(try_subclass());


print("=== 8. Reflection of param annotations ===");
@target("parameter")
annotation Doc(text: string = "") {}

fn documented(@Doc(text = "user identifier") uid: int): int { ret uid; }
documented(7);
print(annotations_of("param:documented.uid"));


print("=== ALL V2 TESTS PASSED ===");
