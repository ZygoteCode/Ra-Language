pub fn assert_eq(actual, expected, label: string) {
    if (actual != expected) {
        print("FAIL " + label + " expected=" + expected + " actual=" + actual);
    } else {
        print("OK   " + label);
    }
}

pub fn assert_true(value: bool, label: string) {
    if (!value) {
        print("FAIL " + label);
    } else {
        print("OK   " + label);
    }
}

print("=== CSHARP INLINE TESTS ===");

print("--- inline csharp: constant return ---");
let r1 = csharp { return 42; };
assert_eq(r1, 42, "constant return value");

print("--- inline csharp: multi-line, return type coercion ---");
let r2 = csharp -> int {
    int a = 10;
    int b = 32;
    return a + b;
};
assert_eq(r2, 42, "multi-line statements + arrow return type");

print("--- inline csharp: string return ---");
let r3 = csharp -> string {
    var sb = new System.Text.StringBuilder();
    sb.Append("hello");
    sb.Append(" ");
    sb.Append("world");
    return sb.ToString();
};
assert_eq(r3, "hello world", "StringBuilder concatenation");

print("--- inline csharp: variable interpolation (auto) ---");
let xv = 7;
let yv = 35;
let r4 = csharp -> int {
    return %{xv} + %{yv};
};
assert_eq(r4, 42, "auto-literal interpolation %{xv} + %{yv}");

print("--- inline csharp: typed interpolation ---");
let big = 100000000000L;
let r5 = csharp -> long {
    long b = %{big:long};
    return b + 1;
};
assert_eq(r5, 100000000001L, "typed long interpolation");

print("--- inline csharp: string interpolation as quoted literal ---");
let who = "Ra";
let r6 = csharp -> string {
    return "hi " + %{who:str};
};
assert_eq(r6, "hi Ra", "%{who:str} renders as C# quoted string literal");

print("--- inline csharp: raw interpolation (templating) ---");
let pieceA = "foo";
let pieceB = "bar";
let r7 = csharp -> string {
    return "%{pieceA:raw}-%{pieceB:raw}";
};
assert_eq(r7, "foo-bar", "raw substitution emits unquoted text");

print("--- inline csharp: using namespace + ref external assembly ---");
let r8 = csharp using System.Collections.Immutable ref "System.Collections.Immutable" -> int {
    var arr = ImmutableArray.Create(10, 20, 30);
    return arr[1];
};
assert_eq(r8, 20, "System.Collections.Immutable reachable via using + ref");

print("--- inline csharp: using two namespaces, list return ---");
let r9 = csharp using System.Linq, System.Collections.Generic {
    var src = new List<int> { 5, 4, 3, 2, 1 };
    return src.OrderBy(x => x).ToList();
};
print("list = " + r9);
assert_eq(r9[0], 1, "OrderBy element [0]");
assert_eq(r9[4], 5, "OrderBy element [4]");

print("--- inline csharp: lambda + generics ---");
let r10 = csharp -> int {
    System.Func<int, int> sq = x => x * x;
    return sq(7);
};
assert_eq(r10, 49, "generic delegate + lambda");

print("--- inline csharp: locally-declared class ---");
let r11 = csharp -> int {
    int Compute(int n)
    {
        int total = 0;
        for (int i = 1; i <= n; i++) total += i;
        return total;
    }
    return Compute(10);
};
assert_eq(r11, 55, "local function recursion-free sum");

print("--- inline csharp: nested braces in strings ---");
let r12 = csharp -> string {
    return $"a={{1+2}} b={1+2}";
};
assert_eq(r12, "a={1+2} b=3", "verbatim + interpolated string with brace escapes");

print("--- inline csharp: System.Math via default imports ---");
let r13 = csharp -> double {
    return Math.Sqrt(2.0);
};
assert_true(r13 > 1.414 && r13 < 1.415, "Math.Sqrt(2)");

print("--- inline csharp: void / null return ---");
let r14 = csharp -> void {
    var dummy = 1 + 1;
};
assert_eq(r14, null, "explicit void return marshals to null");

print("--- inline csharp: bool return ---");
let r15 = csharp -> bool {
    return 5 > 3;
};
assert_eq(r15, true, "bool return marshals to Ra bool");

print("--- inline csharp: map return ---");
let r16 = csharp using System.Collections.Generic -> map {
    var d = new Dictionary<string, int>();
    d["a"] = 1;
    d["b"] = 2;
    return d;
};
assert_eq(r16["a"], 1, "Dictionary entry [a]");
assert_eq(r16["b"], 2, "Dictionary entry [b]");

print("--- inline csharp: compile-error surfaces as Ra runtime error ---");
var caught_compile = false;
try {
    let bad = csharp -> int {
        return this_symbol_does_not_exist + 1;
    };
} catch (e) {
    caught_compile = true;
}
assert_true(caught_compile, "csharp compile error caught as Ra exception");

print("--- inline csharp: runtime-exception surfaces as Ra runtime error ---");
var caught_runtime = false;
try {
    let bad2 = csharp -> int {
        throw new System.InvalidOperationException("boom");
    };
} catch (e) {
    caught_runtime = true;
}
assert_true(caught_runtime, "csharp throw caught as Ra exception");

print("--- inline csharp: caching (same block, multiple executions) ---");
fn run_twice() {
    var acc = 0;
    for i = 0 to 2 step 1 {
        let v = csharp -> int {
            int x = 21;
            return x + x;
        };
        acc = acc + v;
    }
    ret acc;
}
let r17 = run_twice();
assert_eq(r17, 84, "same csharp body reused via cached Script<T>");

print("--- inline csharp: large block with control flow ---");
let r18 = csharp using System.Linq -> int {
    int total = 0;
    foreach (var n in Enumerable.Range(1, 100))
    {
        if (n % 2 == 0) continue;
        total += n;
    }
    return total;
};
assert_eq(r18, 2500, "sum of odd 1..100 = 50^2 = 2500");

print("--- inline csharp: complex interpolation in template ---");
let prefix = "Item";
let count = 3;
let r19 = csharp using System.Linq -> string {
    var prefix = %{prefix:str};
    var n = %{count:int};
    return string.Join(",", Enumerable.Range(1, n).Select(i => prefix + i));
};
assert_eq(r19, "Item1,Item2,Item3", "csharp + Ra interpolation combined");

print("=== CSHARP INLINE TESTS COMPLETED ===");
