// Microbenchmark exercising arithmetic + comparisons in a hot loop.
// Runs a primality check over a range to stress operator dispatch.
fn is_prime(n) {
    if n < 2: ret false;
    if n == 2: ret true;
    if n % 2 == 0: ret false;
    var i = 3;
    while i * i <= n {
        if n % i == 0: ret false;
        i = i + 2;
    }
    ret true;
}

var count = 0;
var k = 2;
while k < 5000 {
    if is_prime(k): count = count + 1;
    k = k + 1;
}
print(count);
