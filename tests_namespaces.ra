// ===================== Ra Language Namespaces Suite =====================

print("=== 1. Simple namespace + qualified access ===");
namespace MyApp {
    pub fn hello() {
        ret "hi from MyApp.hello";
    }
}
print(MyApp.hello());                       // -> hi from MyApp.hello


print("=== 2. Dotted namespace declaration ===");
namespace System.IO {
    pub fn read() {
        ret "System.IO.read called";
    }
}
print(System.IO.read());                    // -> System.IO.read called


print("=== 3. Re-opening same namespace adds members ===");
namespace MyApp {
    pub fn goodbye() {
        ret "bye from MyApp.goodbye";
    }
}
print(MyApp.hello());                       // first member still there
print(MyApp.goodbye());                     // new member also accessible


print("=== 4. Nested namespace via block form ===");
namespace Outer {
    pub fn at_outer() {
        ret "outer";
    }

    namespace Inner {
        pub fn at_inner() {
            ret "inner";
        }
    }
}
print(Outer.at_outer());                    // -> outer
print(Outer.Inner.at_inner());              // -> inner


print("=== 5. Mix: dotted + nested merges into same namespace ===");
namespace System.IO.Files {
    pub fn write() {
        ret "System.IO.Files.write called";
    }
}
print(System.IO.read());                    // still works (added earlier)
print(System.IO.Files.write());             // newly added


print("=== 6. Namespace with constants and types ===");
namespace Math {
    pub const PI = 3.14;
    pub fn double(x) {
        ret x * 2;
    }
}
print(Math.PI);                             // -> 3.14
print(Math.double(21));                     // -> 42


print("=== 7. Using brings members into local scope ===");
namespace Tools {
    pub fn ping() {
        ret "pong";
    }
    pub const VERSION = "1.0";
}
using Tools;
print(ping());                              // -> pong
print(VERSION);                             // -> 1.0


print("=== 8. Using ... as alias ===");
namespace Networking.Http {
    pub fn get() {
        ret "GET ok";
    }
}
using Networking.Http as H;
print(H.get());                             // -> GET ok


print("=== 9. Inside a namespace body, sibling names visible ===");
namespace Bag {
    pub fn first() {
        ret "first()";
    }
    pub fn second() {
        ret first() + " then second()";
    }
}
print(Bag.second());                        // -> first() then second()


print("=== 10. Inside a nested namespace, outer names visible ===");
namespace Family {
    pub const SURNAME = "Rossi";
    namespace Member {
        pub fn full(name) {
            ret name + " " + SURNAME;
        }
    }
}
print(Family.Member.full("Mario"));         // -> Mario Rossi


print("=== 11. Namespace symbol itself stored as a value ===");
var ns_ref = Math;
print(ns_ref.PI);                           // -> 3.14
print(typeof Math);                         // -> namespace


print("=== 12. Non-public namespace members are hidden ===");
namespace Secret {
    fn hidden() {
        ret "should not be visible";
    }
    pub fn visible() {
        ret "visible from outside";
    }
}
print(Secret.visible());
try {
    print(Secret.hidden());
} catch (e) {
    print("caught private namespace member");
}


print("=== 13. Accessing undefined member yields error ===");
try {
    print(MyApp.does_not_exist());
} catch (e) {
    print("caught missing namespace member");
}


print("=== 14. Nested re-opening merges deeply ===");
namespace Deep.A.B {
    pub fn one() { ret 1; }
}
namespace Deep.A.B {
    pub fn two() { ret 2; }
}
namespace Deep {
    namespace A {
        namespace B {
            pub fn three() { ret 3; }
        }
    }
}
print(Deep.A.B.one() + Deep.A.B.two() + Deep.A.B.three());   // -> 6


print("=== 15. Class inside namespace and instantiation ===");
namespace UI.Widgets {
    pub class Button {
        pub var label;
        pub fn Button(label) {
            self.label = label;
        }
        pub fn click() {
            ret "clicked " + self.label;
        }
    }
}
var b = UI.Widgets.Button("OK");
print(b.click());                           // -> clicked OK


print("=== Namespaces suite finished ===");
