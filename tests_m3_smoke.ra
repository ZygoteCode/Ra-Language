// M3 smoke test: control flow native lowering.
//
// Run with --ir RA_VM_STATS=1 — expect a high native_ops:ast_fallbacks
// ratio.

print("=== M3 smoke ===");

// Plain if/else with comparison.
var x = 7;
if x > 5 { x = x - 1; } else { x = x + 1; }

// While with break+continue. Body has no bindings → native eligible.
var i = 0;
var acc = 0;
while i < 10 {
    i = i + 1;
    if i == 3 { continue; }
    if i == 8 { break; }
    acc = acc + i;
}

// do-while.
var j = 0;
do {
    j = j + 1;
} while j < 5;

// Short-circuit and/or — left side falsy should skip right.
var lhs = false;
var ok = lhs and (acc / 0 == 0);  // RHS would crash if evaluated
if ok { print("[and] FAIL"); } else { print("[and] OK"); }

// Unary minus.
var n = -5;
if n == -5 { print("[neg] OK"); } else { print("[neg] FAIL"); }

// Nested if inside while.
var sum = 0;
var k = 0;
while k < 5 {
    k = k + 1;
    if k % 2 == 0 { sum = sum + k; }
}
if sum == 6 { print("[nest] OK"); } else { print("[nest] FAIL " + (sum as string)); }

print("[M3] OK");
