{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.ra",
  "name": "Ra",
  "fileTypes": [
    "ra"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#lifetimes"
    },
    {
      "include": "#regex-literal"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#asm-block"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ra",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ra"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.line.number-sign.ra",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ra"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.line.triple-dash.ra",
          "begin": "---",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.ra"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.ra",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.ra"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.ra"
            }
          }
        },
        {
          "name": "comment.block.cdata.ra",
          "begin": "<!--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.ra"
            }
          },
          "end": "-->",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.ra"
            }
          }
        }
      ]
    },
    "lifetimes": {
      "comment": "A `'name` not closed by another `'` is a lifetime; `'a'` is a single-quoted string and is handled by #strings.",
      "patterns": [
        {
          "match": "(')([A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_'\\\\])",
          "captures": {
            "1": {
              "name": "punctuation.definition.lifetime.ra"
            },
            "2": {
              "name": "storage.modifier.lifetime.ra entity.name.type.lifetime.ra"
            }
          }
        }
      ]
    },
    "regex-literal": {
      "comment": "Regex literal `re\"pattern\"flags`. Flags: i m s x n (case-insensitive).",
      "patterns": [
        {
          "name": "string.regexp.ra",
          "begin": "\\b(re)(\")",
          "beginCaptures": {
            "1": {
              "name": "support.function.regexp.ra"
            },
            "2": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "(\")([imsxnIMSXN]*)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.ra"
            },
            "2": {
              "name": "keyword.other.flags.regexp.ra"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.regexp.ra",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.ra",
          "begin": "(\\$)(\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.interpolation.prefix.ra"
            },
            "2": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ra"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.interpolated.ra",
          "begin": "(\\$)(')",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.interpolation.prefix.ra"
            },
            "2": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ra"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.backtick.interpolated.ra",
          "begin": "(\\$)(`)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.interpolation.prefix.ra"
            },
            "2": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ra"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.ra",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ra"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.ra",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ra"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.backtick.ra",
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.ra"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ra"
            }
          },
          "patterns": [
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.ra",
          "match": "\\\\(?:[abfnrtv0\\\\\"'`$]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4})"
        },
        {
          "name": "constant.character.escape.ra",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "comment": "Interpolation hole `${ expr }` (optionally with a `:format` spec). Only legal inside $-prefixed strings.",
      "patterns": [
        {
          "name": "meta.interpolation.ra",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.ra"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.ra"
            }
          },
          "patterns": [
            {
              "include": "source.ra"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ra",
          "match": "\\b0[xX][0-9a-fA-F_]+(?:[uU][iIlLsS]|[iIlLsSfFdDmM])?\\b"
        },
        {
          "name": "constant.numeric.binary.ra",
          "match": "\\b0[bB][01_]+(?:[uU][iIlLsS]|[iIlLsSfFdDmM])?\\b"
        },
        {
          "name": "constant.numeric.octal.ra",
          "match": "\\b0[oO][0-7_]+(?:[uU][iIlLsS]|[iIlLsSfFdDmM])?\\b"
        },
        {
          "name": "constant.numeric.float.ra",
          "match": "\\b(?:\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|\\d[\\d_]*[eE][+-]?\\d[\\d_]*|\\d[\\d_]*\\.(?!\\.))(?:[fFdDmM])?\\b"
        },
        {
          "name": "constant.numeric.integer.ra",
          "match": "\\b\\d[\\d_]*(?:[uU][iIlLsS]|[iIlLsSfFdDmM])?\\b"
        }
      ]
    },
    "annotations": {
      "comment": "Annotation application `@name` / `@name(args)`. Args fall through to normal expression rules.",
      "patterns": [
        {
          "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.ra"
            },
            "2": {
              "name": "entity.name.decorator.ra meta.decorator.ra"
            }
          }
        }
      ]
    },
    "asm-block": {
      "comment": "Inline assembly: `asm { ... }`. Body is raw text with `%{ expr }` Ra-value interpolation.",
      "patterns": [
        {
          "name": "meta.asm.ra",
          "begin": "\\b(asm)\\b\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.asm.ra"
            },
            "2": {
              "name": "punctuation.section.block.begin.ra"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.ra"
            }
          },
          "contentName": "meta.embedded.block.asm.ra",
          "patterns": [
            {
              "name": "meta.interpolation.asm.ra",
              "begin": "(%)(\\{)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.interpolation.prefix.ra"
                },
                "2": {
                  "name": "punctuation.section.interpolation.begin.ra"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.ra"
                }
              },
              "patterns": [
                {
                  "include": "source.ra"
                }
              ]
            },
            {
              "name": "comment.line.semicolon.asm.ra",
              "match": ";.*$"
            },
            {
              "match": "^\\s*([A-Za-z_.][A-Za-z0-9_.]*)(:)",
              "captures": {
                "1": {
                  "name": "entity.name.label.asm.ra"
                },
                "2": {
                  "name": "punctuation.separator.label.asm.ra"
                }
              }
            },
            {
              "name": "constant.numeric.hex.asm.ra",
              "match": "\\b0[xX][0-9a-fA-F]+\\b"
            },
            {
              "name": "constant.numeric.integer.asm.ra",
              "match": "\\b\\d+\\b"
            }
          ]
        }
      ]
    },
    "declarations": {
      "comment": "Declaration keyword + declared name, so the name gets an entity scope (approximates the LSP's declaration-site classification).",
      "patterns": [
        {
          "match": "\\b(record)(?:\\s+(class))?\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.record.ra"
            },
            "2": {
              "name": "storage.type.class.ra"
            },
            "3": {
              "name": "entity.name.type.record.ra"
            }
          }
        },
        {
          "match": "\\b(class|struct|enum|interface|trait|annotation|delegate)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.ra"
            },
            "2": {
              "name": "entity.name.type.ra"
            }
          }
        },
        {
          "match": "\\b(extend|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.ra keyword.control.$1.ra"
            },
            "2": {
              "name": "entity.name.type.ra"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.ra"
            },
            "2": {
              "name": "entity.name.function.ra"
            }
          }
        },
        {
          "match": "\\b(prop)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.property.ra"
            },
            "2": {
              "name": "variable.other.property.declaration.ra"
            }
          }
        },
        {
          "match": "\\b(event)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.event.ra"
            },
            "2": {
              "name": "entity.name.function.event.ra"
            }
          }
        },
        {
          "match": "\\b(namespace|using)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.ra"
            },
            "2": {
              "name": "entity.name.namespace.ra"
            }
          }
        },
        {
          "match": "\\b(import|from)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.ra"
            },
            "2": {
              "name": "entity.name.namespace.ra"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "Multi-word membership operators must match before the single words.",
          "name": "keyword.operator.word.ra",
          "match": "\\b(?:is\\s+not\\s+in|is\\s+in|not\\s+in)\\b"
        },
        {
          "name": "constant.language.ra",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.language.ra",
          "match": "\\b(?:self|super)\\b"
        },
        {
          "name": "keyword.operator.word.ra",
          "match": "\\b(?:and|or|not|is|as|in|typeof|nameof)\\b"
        },
        {
          "name": "keyword.control.import.ra",
          "match": "\\b(?:import|from|using|namespace)\\b"
        },
        {
          "name": "keyword.control.ra",
          "match": "\\b(?:if|elif|else|for|while|do|switch|case|default|match|try|catch|finally|retry|break|continue|ret|yield|goto|pass|throw|del|to|step|times|delay|where|with|await|spawn|emit|asm)\\b"
        },
        {
          "name": "storage.type.ra",
          "match": "\\b(?:fn|class|struct|interface|trait|enum|record|annotation|delegate|event|prop|extend|impl|operator)\\b"
        },
        {
          "name": "storage.modifier.ra",
          "match": "\\b(?:pub|abstract|static|override|final|const|let|var|auto|mut|ref|move|async|lazy|factory|cancellable|tolerant)\\b"
        },
        {
          "comment": "Contextual property/event accessors. Lookahead keeps false positives off ordinary identifiers.",
          "name": "keyword.other.accessor.ra",
          "match": "\\b(?:get|set|init|observe|raise)\\b(?=\\s*(?:;|\\{|=>|=\\b))"
        },
        {
          "name": "support.type.primitive.ra",
          "match": "\\b(?:int|number|long|float|double|uint|ulong|short|ushort|int128|uint128|decimal|byte|bool|string|char|void|object|any)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ra",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arrow.ra",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.ra",
          "match": ">>>>=|<<<<=|>>>=|<<<=|>>=|<<=|\\*\\*=|\\?\\?=|&&=|\\|\\|=|\\+=|-=|\\*=|/=|%=|\\^=|&=|\\|="
        },
        {
          "name": "keyword.operator.bitwise.shift.ra",
          "match": ">>>>|<<<<|>>>|<<<|>>|<<"
        },
        {
          "comment": "Pipe-forward, cast path, ranges, spread, null-coalescing.",
          "name": "keyword.operator.ra",
          "match": "\\|>|::|\\.\\.=|\\.\\.\\.|\\.\\.|\\?\\?"
        },
        {
          "name": "keyword.operator.logical.ra",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.ra",
          "match": "\\+\\+|--|\\*\\*|\\+|-|\\*|/|%|\\^"
        },
        {
          "name": "keyword.operator.bitwise.ra",
          "match": "&|\\||~"
        },
        {
          "name": "keyword.operator.assignment.ra",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.ra",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.ternary.ra",
          "match": "\\?|:"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.ra",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.ra",
          "match": ","
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "Member method call: `.name(`",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.ra"
            },
            "2": {
              "name": "entity.name.function.member.ra"
            }
          }
        },
        {
          "comment": "Member access: `.name`",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.ra"
            },
            "2": {
              "name": "variable.other.property.ra"
            }
          }
        },
        {
          "comment": "PascalCase identifier immediately before `(` reads as a constructor / type call.",
          "name": "entity.name.type.ra",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "comment": "lowercase identifier before `(` reads as a function call.",
          "name": "entity.name.function.call.ra",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "comment": "Bare PascalCase identifier reads as a type reference (Ra types are PascalCase by convention; mirrors the LSP type set).",
          "name": "entity.name.type.ra",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.ra",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
