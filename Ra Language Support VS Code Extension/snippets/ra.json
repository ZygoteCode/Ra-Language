{
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },
  "If inline": {
    "prefix": "if:",
    "body": "if ${1:condition}: $0",
    "description": "Inline if statement"
  },
  "Elif": {
    "prefix": "elif",
    "body": [
      "elif (${1:condition})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Else-if branch"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition})",
      "{",
      "\t$2",
      "}",
      "else",
      "{",
      "\t$0",
      "}"
    ],
    "description": "If / else statement"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value})",
      "{",
      "\tcase ${2:pattern}: $3; break;",
      "\tdefault: $0;",
      "}"
    ],
    "description": "Switch block (colon form)"
  },
  "Switch arrow": {
    "prefix": "switcharrow",
    "body": [
      "switch (${1:value})",
      "{",
      "\tcase ${2:pattern} -> $3;",
      "\tdefault -> $0;",
      "}"
    ],
    "description": "Switch block (arrow form)"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}",
      "{",
      "\tcase ${2:pattern} -> $3",
      "\tcase _ -> $0",
      "}"
    ],
    "description": "Match expression"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while (${1:condition})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Do / while": {
    "prefix": "dowhile",
    "body": [
      "do",
      "{",
      "\t$1",
      "}",
      "while (${2:condition})"
    ],
    "description": "Do / while loop"
  },
  "For-in": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:collection}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "For-in loop"
  },
  "For range": {
    "prefix": "for",
    "body": [
      "for ${1:i} = ${2:0} to ${3:n} step ${4:1}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Range for loop"
  },
  "For C-style": {
    "prefix": "forc",
    "body": [
      "for (var ${1:i} = ${2:0}; ${1:i} < ${3:n}; ${1:i}++)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "C-style for loop"
  },
  "Retry": {
    "prefix": "retry",
    "body": [
      "retry for ${1:count} times delay ${2:delay}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Retry block"
  },
  "Try / catch / finally": {
    "prefix": "try",
    "body": [
      "try",
      "{",
      "\t$1",
      "}",
      "catch (${2:error})",
      "{",
      "\t$3",
      "}",
      "finally",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Try / catch / finally"
  },
  "Try / catch": {
    "prefix": "trycatch",
    "body": [
      "try",
      "{",
      "\t$1",
      "}",
      "catch (${2:error})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Try / catch"
  },
  "Label": {
    "prefix": "label",
    "body": [
      "${1:label}:",
      "\t$0"
    ],
    "description": "Label"
  },

  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Function"
  },
  "Public function": {
    "prefix": "pubfn",
    "body": [
      "pub fn ${1:name}(${2:args})${3:: ${4:type}}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Public function"
  },
  "Abstract function": {
    "prefix": "abfn",
    "body": [
      "abstract fn ${1:name}(${2:args})${3:: ${4:type}};"
    ],
    "description": "Abstract function"
  },
  "Static function": {
    "prefix": "stfn",
    "body": [
      "static fn ${1:name}(${2:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Static function"
  },
  "Override function": {
    "prefix": "ovfn",
    "body": [
      "override fn ${1:name}(${2:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Override function"
  },
  "Async function": {
    "prefix": "asyncfn",
    "body": [
      "async fn ${1:name}(${2:args}) => $0;"
    ],
    "description": "Async function (arrow body)"
  },
  "Operator overload": {
    "prefix": "operator",
    "body": [
      "operator ${1:+}(${2:other}: ${3:Type}): ${4:Type}",
      "{",
      "\tret $0;",
      "}"
    ],
    "description": "Operator overload"
  },

  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Class"
  },
  "Public class": {
    "prefix": "pubclass",
    "body": [
      "pub class ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Public class"
  },
  "Abstract class": {
    "prefix": "abclass",
    "body": [
      "abstract class ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Abstract class"
  },
  "Class : Base impl Interface": {
    "prefix": "classimpl",
    "body": [
      "pub class ${1:Name} : ${2:Base} impl ${3:Interface}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Class with base and interface"
  },
  "Generic class": {
    "prefix": "genclass",
    "body": [
      "pub class ${1:Name}<${2:T}>",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Generic class"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Struct"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Interface"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Trait"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}",
      "{",
      "\t${2:Variant1},",
      "\t${3:Variant2}$0",
      "}"
    ],
    "description": "Enum"
  },
  "Enum (ADT)": {
    "prefix": "enumadt",
    "body": [
      "enum ${1:Name}",
      "{",
      "\t${2:Variant}(${3:int}),",
      "\t${4:Empty}$0",
      "}"
    ],
    "description": "Algebraic-data-type enum with payloads"
  },
  "Record": {
    "prefix": "record",
    "body": [
      "record ${1:Name}(${2:field}: ${3:type})$0"
    ],
    "description": "Value record"
  },
  "Record class": {
    "prefix": "recordclass",
    "body": [
      "record class ${1:Name}(${2:field}: ${3:type})$0"
    ],
    "description": "Reference (class) record"
  },
  "Record with body": {
    "prefix": "recordbody",
    "body": [
      "record ${1:Name}(${2:field}: ${3:type})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Record with a method body"
  },
  "Annotation definition": {
    "prefix": "annotation",
    "body": [
      "annotation ${1:Name}",
      "{",
      "\t${2:field}: ${3:type}$0",
      "}"
    ],
    "description": "Annotation declaration"
  },
  "Delegate": {
    "prefix": "delegate",
    "body": [
      "delegate ${1:Name} = fn(${2:int}) -> ${3:bool}$0"
    ],
    "description": "Delegate type alias"
  },
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Namespace"
  },
  "Implements clause": {
    "prefix": "impl",
    "body": [
      "impl ${1:Interface}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Implements interfaces"
  },
  "Extend block": {
    "prefix": "extend",
    "body": [
      "extend ${1:Type}",
      "{",
      "\tpub fn ${2:method}(${3:args})",
      "\t{",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Extension block"
  },
  "Extend with operator": {
    "prefix": "extendop",
    "body": [
      "extend ${1:Type}",
      "{",
      "\tpub operator${2:+}(${3:other}: ${1:Type}): ${1:Type} { ret $0; }",
      "}"
    ],
    "description": "Extension block with operator overload"
  },

  "Property (auto)": {
    "prefix": "prop",
    "body": [
      "pub prop ${1:name}: ${2:type} = ${3:default}$0"
    ],
    "description": "Auto stored property"
  },
  "Property (get / set)": {
    "prefix": "propgetset",
    "body": [
      "pub prop ${1:name}: ${2:type} = ${3:default}",
      "{",
      "\tget",
      "\tset { field = value; }",
      "}"
    ],
    "description": "Property with explicit get / set"
  },
  "Property (computed)": {
    "prefix": "propget",
    "body": [
      "pub prop ${1:name}: ${2:type} => $0"
    ],
    "description": "Computed property (arrow)"
  },
  "Property (lazy)": {
    "prefix": "proplazy",
    "body": [
      "pub lazy prop ${1:name}: ${2:type} = $0"
    ],
    "description": "Lazy property"
  },
  "Property (abstract)": {
    "prefix": "propabstract",
    "body": [
      "pub abstract prop ${1:name}: ${2:type} { get; }$0"
    ],
    "description": "Abstract property contract"
  },
  "Event": {
    "prefix": "event",
    "body": [
      "pub event ${1:Name}(${2:args})$0"
    ],
    "description": "Event declaration"
  },
  "Event (cancellable)": {
    "prefix": "eventcancellable",
    "body": [
      "pub cancellable event ${1:Name}(${2:args})$0"
    ],
    "description": "Cancellable event declaration"
  },
  "Event (tolerant)": {
    "prefix": "eventtolerant",
    "body": [
      "pub tolerant event ${1:Name}(${2:args})$0"
    ],
    "description": "Tolerant event declaration"
  },

  "Constructor": {
    "prefix": "ctor",
    "body": [
      "pub ${1:Type}(${2:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Generative constructor"
  },
  "Named constructor": {
    "prefix": "ctorname",
    "body": [
      "pub ${1:Type}.${2:name}(${3:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Named generative constructor"
  },
  "Factory constructor": {
    "prefix": "factory",
    "body": [
      "pub factory ${1:Type}.${2:name}(${3:args})",
      "{",
      "\tret $0;",
      "}"
    ],
    "description": "Factory constructor"
  },

  "Variable": {
    "prefix": "var",
    "body": "var ${1:name} = ${2:value};$0",
    "description": "Mutable variable"
  },
  "Let binding": {
    "prefix": "let",
    "body": "let ${1:name} = ${2:value};$0",
    "description": "Immutable binding"
  },
  "Let mut binding": {
    "prefix": "letmut",
    "body": "let mut ${1:name} = ${2:value};$0",
    "description": "Mutable let binding"
  },
  "Const": {
    "prefix": "const",
    "body": "const ${1:NAME} = ${2:value};$0",
    "description": "Constant"
  },
  "Final": {
    "prefix": "final",
    "body": "final ${1:name} = ${2:value};$0",
    "description": "Final binding"
  },
  "Public field": {
    "prefix": "pubvar",
    "body": "pub var ${1:name}: ${2:type};$0",
    "description": "Public field"
  },

  "Import": {
    "prefix": "import",
    "body": "import \"${1:path}.ra\";$0",
    "description": "Import a module by path"
  },
  "Import as": {
    "prefix": "importas",
    "body": "import \"${1:path}.ra\" as ${2:alias};$0",
    "description": "Import with alias"
  },
  "Import from": {
    "prefix": "importfrom",
    "body": "import { ${1:symbol} } from \"${2:path}.ra\";$0",
    "description": "Selective import"
  },
  "Import std": {
    "prefix": "importstd",
    "body": "import std.${1:io};$0",
    "description": "Import a standard library module"
  },
  "Using": {
    "prefix": "using",
    "body": "using ${1:Namespace};$0",
    "description": "Bring a namespace into scope"
  },

  "Return": {
    "prefix": "ret",
    "body": "ret ${1:value};$0",
    "description": "Return statement"
  },
  "Yield": {
    "prefix": "yield",
    "body": "yield ${1:value};$0",
    "description": "Yield statement"
  },
  "Emit": {
    "prefix": "emit",
    "body": "emit ${1:value};$0",
    "description": "Emit (generator stream)"
  },
  "Throw": {
    "prefix": "throw",
    "body": "throw ${1:value};$0",
    "description": "Throw statement"
  },
  "Await": {
    "prefix": "await",
    "body": "await ${1:task}$0",
    "description": "Await expression"
  },
  "Spawn": {
    "prefix": "spawn",
    "body": "spawn ${1:call}$0",
    "description": "Spawn expression"
  },
  "Delete": {
    "prefix": "del",
    "body": "del ${1:name};$0",
    "description": "Delete a binding"
  },

  "Lambda": {
    "prefix": "lambda",
    "body": "|${1:x}| $0",
    "description": "Bar lambda (expression body)"
  },
  "Lambda typed": {
    "prefix": "lambdatyped",
    "body": "|${1:x}: ${2:int}| -> ${3:int} $0",
    "description": "Typed bar lambda"
  },
  "Lambda block": {
    "prefix": "lambdablock",
    "body": [
      "|${1:x}| -> ${2:type}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Bar lambda (block body)"
  },
  "Anonymous fn": {
    "prefix": "fnlambda",
    "body": "fn(${1:x}: ${2:int}): ${3:int} => $0",
    "description": "Anonymous fn expression"
  },
  "Pipe forward": {
    "prefix": "pipe",
    "body": "${1:value} |> ${2:fn}$0",
    "description": "Pipeline-forward expression"
  },
  "With expression": {
    "prefix": "with",
    "body": "${1:record} with { ${2:field}: ${3:value} }$0",
    "description": "Record update (with-expression)"
  },
  "Cast": {
    "prefix": "as",
    "body": "${1:value} as ${2:type}$0",
    "description": "Cast expression"
  },
  "Range": {
    "prefix": "range",
    "body": "${1:start}..${2:end}$0",
    "description": "Range expression"
  },
  "Null-coalescing": {
    "prefix": "nullcoalesce",
    "body": "${1:left} ?? ${2:right}$0",
    "description": "Null-coalescing expression"
  },
  "nameof": {
    "prefix": "nameof",
    "body": "nameof(${1:identifier})$0",
    "description": "nameof expression"
  },
  "typeof": {
    "prefix": "typeof",
    "body": "typeof(${1:expression})$0",
    "description": "typeof expression"
  },
  "Interpolated string": {
    "prefix": "interp",
    "body": "$\"${1:text}${${2:expr}}\"$0",
    "description": "Interpolated string literal"
  },
  "Regex literal": {
    "prefix": "regex",
    "body": "re\"${1:pattern}\"${2:i}$0",
    "description": "Regex literal"
  },
  "Inline assembly": {
    "prefix": "asm",
    "body": [
      "asm {",
      "\t$0",
      "}"
    ],
    "description": "Inline assembly block"
  },

  "Line comment": {
    "prefix": "//",
    "body": "// $1",
    "description": "Line comment"
  },
  "Block comment": {
    "prefix": "/*",
    "body": [
      "/*",
      " * $1",
      " */"
    ],
    "description": "Block comment"
  },
  "Region": {
    "prefix": "region",
    "body": [
      "// region ${1:name}",
      "$0",
      "// endregion"
    ],
    "description": "Foldable region marker"
  }
}
