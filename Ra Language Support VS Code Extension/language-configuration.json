{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "colorizedBracketPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/*",
      "close": "*/",
      "notIn": [
        "string"
      ]
    }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t\r",
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "`",
      "close": "`"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$",
    "decreaseIndentPattern": "^\\s*[\\}\\)\\]]"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*(?://|#|---|<!--)\\s*#?region\\b",
      "end": "^\\s*(?://|#|---|<!--)\\s*#?endregion\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(//)\\s*(.*)$",
      "action": {
        "indentAction": "none",
        "appendText": "// "
      }
    },
    {
      "beforeText": "^\\s*(#)\\s*(.*)$",
      "action": {
        "indentAction": "none",
        "appendText": "# "
      }
    },
    {
      "beforeText": "^\\s*(---)\\s*(.*)$",
      "action": {
        "indentAction": "none",
        "appendText": "--- "
      }
    },
    {
      "beforeText": "^\\s*/\\*([^*]|\\*(?!/))*$",
      "afterText": "^([^*]|\\*(?!/))*\\*/\\s*$",
      "action": {
        "indentAction": "indentOutdent",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*/\\*([^*]|\\*(?!/))*$",
      "action": {
        "indentAction": "indent"
      }
    }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
