pub struct Point {
    pub var x: number,
    pub var y: number

    pub fn Point(x, y) {
        self.x = x;
        self.y = y;
    }
}

extend Point {
    pub fn distance() {
        var sq = self.x * self.x + self.y * self.y;
        ret sq;
    }
    
    pub fn summarize() {
        ret "Point at (" + self.x + ", " + self.y + ")";
    }
}

var p = Point(3, 4);
print("Distance squared: " + p.distance());
print("Summary: " + p.summarize());