fn test() {
    ret 5 + 10;
}

var x = (1, 2, "test", test());
print(x);
print(x[2]);
print(x / 0);
print(x % 5);
print(x[-1]);
print(x << 2);
print(x >> 1);
print(x + (5, 6));
print(x + [7, 8]);
print(x + 100);
print(x * 2);
print(x ^ 2);
print(x & (1, 2, 3, 4));
print(x | (0, 2, 100, 7));
print(~x);
print(x - 1);
print(x - "test");
print(x % "test");
print(x && (true, false, true, true)); 
print(x || (false, false, true, false));
print(x == (1, 2, "test", 15));
print(x != (1, 2, "test", 0));
print(x < (2, 0, "a", 1));
print(x > (0, 5, "z", 100));
print(x <= (1, 2, "test", 15));
print(x >= (1, 2, "test", 14));