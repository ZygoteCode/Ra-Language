var a: number = 5;
var b: string = a as string;
print(b);

fn test(a, b, ...params) {
    ret a + b + params[0] + params[1];
}

fn test1(a, b, ...lol) {
    ret a + b + lol[0];
}

print(test(1, 2, 3, 4));
print(test1(1, 2, 3));

fn f(a, b, c = 3, d = 7, ...params) {
    ret a + b + c + d;
}

print(f(1,2));
print(f(1,2,5,6,8));
print(f(1,2, params: [8]));
print(f(params: [31], c: 46, a: 99, b: 71));

try {
    print(x);
} catch (e) {
    print("caught: " + e);
} finally {
    print("always executed");
}

print("after that");

try {
    print(y);
}

try {
    print(yyy);
} finally {
    print("after all");
}