pub class Person {
    pub var name: string;

    pub Person(name: string) {
        self.name = name;
    }

    pub fn get_name() {
        ret self.name;
    }
}

extend Person {
    fn greet() {
        print("Hello " + self.get_name());
    }
}

var p = Person("Gabriele");
p.greet();

extend string {
    fn shout() {
        self[0] = "a";
        ret self + "!!!";
    }
}

print("hello".shout());

extend int {
    fn sum(other: int) {
        ret self + other;
    }
}

var xy: int = "3"::int;
print(xy.sum(5));

fn apply(f, x) {
    ret f(x);
}

fn double(n) {
    ret n * 2;
}

print(apply(double, 5));