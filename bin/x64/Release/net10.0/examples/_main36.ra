fn
    test
        (
            x
            :
            String
        )
        :
        int
    {
        retry
        for 5 times
        delay 250
        {
            print("trying...");
            5 / 0;
        }
        else
        {
            print("failed so bad");
        }

        ret 5;
    }

test("2");

