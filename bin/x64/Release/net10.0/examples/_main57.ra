pub fn assert_eq(actual, expected, label: string) {
    if (actual != expected) {
        print("FAIL " + label + " expected=" + expected + " actual=" + actual);
    } else {
        print("OK   " + label);
    }
}

pub fn assert_true(value: bool, label: string) {
    if (!value) {
        print("FAIL " + label);
    } else {
        print("OK   " + label);
    }
}

pub class Animal {
    pub var name: string = "?";

    pub Animal(name: string) {
        self.name = name;
    }

    pub fn speak() {
        ret "<silence>";
    }

    pub fn describe() {
        ret self.name + " says " + self.speak();
    }
}

pub class Dog : Animal {
    pub Dog(name: string) {
        super(name);
    }

    pub override fn speak() {
        ret "woof";
    }
}

pub class Puppy : Dog {
    pub Puppy(name: string) {
        super(name);
    }

    pub override fn speak() {
        ret "yip";
    }
}

var rex = Dog("Rex");
assert_eq(rex.speak(), "woof", "child override returns own");
assert_eq(rex.describe(), "Rex says woof", "virtual dispatch via base method");

var pip = Puppy("Pip");
assert_eq(pip.speak(), "yip", "grandchild override returns own");
assert_eq(pip.describe(), "Pip says yip", "virtual dispatch through grandchild");

pub trait Named {
    fn get_name();
}

pub trait Greeting {
    fn greet() {
        ret "hi";
    }
}

pub class Person with Named, Greeting {
    pub var name: string;

    pub Person(name: string) {
        self.name = name;
    }

    pub fn get_name() {
        ret self.name;
    }
}

var alice = Person("Alice");
assert_eq(alice.get_name(), "Alice", "trait required method implemented without override");
assert_eq(alice.greet(), "hi", "trait default method inherited without override");

pub class Greeter with Greeting {
    pub Greeter() {}

    pub override fn greet() {
        ret "hola";
    }
}

var g = Greeter();
assert_eq(g.greet(), "hola", "class can override trait default with override keyword");

pub abstract class Shape {
    pub abstract fn area();

    pub fn describe() {
        ret "area=" + self.area();
    }
}

pub class Square : Shape {
    pub var side: int = 0;

    pub Square(side: int) {
        self.side = side;
    }

    pub override fn area() {
        ret self.side * self.side;
    }
}

var sq = Square(4);
assert_eq(sq.area(), 16, "concrete impl of abstract method");
assert_eq(sq.describe(), "area=16", "inherited concrete method calls overridden abstract");

pub class TripleA {
    pub var tag: string = "";

    pub TripleA(t: string) {
        self.tag = t;
    }
}

pub class TripleB : TripleA {
    pub TripleB(t: string) {
        super(t);
    }
}

pub class TripleC : TripleB {
    pub TripleC(t: string) {
        super(t);
    }
}

var triple = TripleC("deep");
assert_eq(triple.tag, "deep", "3-level super chain terminates and binds correctly");

pub class CtorArity {
    pub var x: int = 0;

    pub CtorArity(x: int) {
        self.x = x;
    }
}

var caught_ctor_miss = false;
try {
    var bad = CtorArity();
} catch (e) {
    caught_ctor_miss = true;
}
assert_true(caught_ctor_miss, "calling 0-arg ctor when class declares 1-arg ctor fails loudly");

var caught_extra_args = false;
try {
    var bad2 = CtorArity(1, 2, 3);
} catch (e) {
    caught_extra_args = true;
}
assert_true(caught_extra_args, "calling 3-arg ctor when class declares 1-arg ctor fails loudly");

pub trait LeftLog {
    fn label() { ret "left"; }
}

pub trait RightLog {
    fn label() { ret "right"; }
}

pub class DiamondResolved with LeftLog, RightLog {
    pub DiamondResolved() {}

    pub override fn label() {
        ret "resolved";
    }
}

var dr = DiamondResolved();
assert_eq(dr.label(), "resolved", "class override resolves trait diamond ambiguity");

pub class Sealed1 {
    pub fn open() { ret "v1"; }
}

pub class Sealed2 : Sealed1 {
    pub override fn open() { ret "v2"; }
}

pub class Sealed3 : Sealed2 {
    pub override fn open() { ret "v3"; }
}

var s = Sealed3();
assert_eq(s.open(), "v3", "transitive override across 3 levels uses most-derived");
