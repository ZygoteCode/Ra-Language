pub class Person {
    pub var age: int;

    pub Person(age: int) {
        self.age = age;
    }

    pub fn increment(ref val: int) {
        val += 3;
    }

    pub fn to_string(): string {
        ret $"Person with age: ${self.age}";
    }
}

fn sum(ref val: int, a: int, b: int) {
    val = a + b;
}

var k: int = 5;
sum(&k, 3, 8);

print(k);

var p: Person = Person(5);
print(p);

p.increment(&k);
print(k);
p.increment(&p.age);
print(p.age);
print(p.to_string());