// ===================== Ra Language Namespaces Multi-File Suite =====================

print("=== 1. Importing file_a contributes to System.IO and System ===");
import "tests_namespaces_helpers/system_io_a.ra";

print(System.IO.open("a.txt"));     // -> open(a.txt)
print(System.IO.MODE_READ);          // -> r
print(System.version());             // -> 1.2.3


print("=== 2. Importing file_b merges into the same System.IO + adds System.IO.Files ===");
import "tests_namespaces_helpers/system_io_b.ra";

print(System.IO.open("b.txt"));      // first member still there
print(System.IO.close("b.txt"));     // new member from file_b
print(System.IO.Files.list());       // newly added child namespace
print(System.version());             // still works


print("=== 3. Local re-opening of System.IO adds yet more members ===");
namespace System.IO {
    pub fn flush() {
        ret "flush";
    }
}
print(System.IO.flush());            // local contribution
print(System.IO.open("c.txt"));      // members from import still present


print("=== 4. Using the merged System.IO brings everything ===");
using System.IO;
print(open("d.txt"));
print(close("d.txt"));
print(flush());
print(MODE_READ);


print("=== Multi-file namespaces suite finished ===");
