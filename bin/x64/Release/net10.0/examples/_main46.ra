pub class Person {
    pub var name: string;

    pub Person(name: string) {
        self.name = name;
    }

    pub fn to_string(): string {
        ret "Person: " + self.name;
    }
}

pub class SuperPerson : Person {
    pub SuperPerson(name: string) {
        super(name);
    }

    pub override fn to_string(): string {
        ret "SuperPerson: " + self.name;
    }
}

var p: Person = Person("Gabriele");

print(p);
print($"Working? ${p}");

var s: string = "User: " + p;
print(s);

var s2: string = p;
print(s2);

var super_person: SuperPerson = SuperPerson("Alessandro");
print(super_person);