# ==============================================================
#  String marshalling regression suite
#  Root-cause: default charset Auto -> UTF-16 on Windows, but
#  ANSI APIs (XxxxA) expect single-byte chars. Result: only the
#  first character survives because the second byte of the UTF-16
#  code unit is 0x00 (NUL terminator under ANSI).
#
#  Fix: when the user does not specify `charset`, infer from the
#  entry_point or function-name suffix (`A` -> Ansi, `W` -> Utf16).
# ==============================================================

@dll_import(library = "kernel32", entry_point = "lstrlenA")
fn len_a(s: string): int { ret 0; }

@dll_import(library = "kernel32", entry_point = "lstrlenW")
fn len_w(s: string): int { ret 0; }

@dll_import(library = "kernel32", entry_point = "lstrlenA")
fn len_a_alias(s: string): int { ret 0; }

@dll_import(library = "kernel32", entry_point = "lstrlenW", charset = "ansi")
fn len_w_forced_ansi(s: string): int { ret 0; }

# strcat-style: copy src into dst, returning dst pointer.
@dll_import(library = "kernel32", entry_point = "lstrcpyA")
fn copy_a(dst: ptr, src: string): ptr { ret 0; }

@dll_import(library = "kernel32", entry_point = "lstrcpyW")
fn copy_w(dst: ptr, src: string): ptr { ret 0; }

# kernel32 lstrcmpA(string, string) -> int
@dll_import(library = "kernel32", entry_point = "lstrcmpA")
fn cmp_a(a: string, b: string): int { ret 0; }

@dll_import(library = "kernel32", entry_point = "lstrcmpW")
fn cmp_w(a: string, b: string): int { ret 0; }

@dll_import(library = "user32", entry_point = "CharUpperA")
fn upper_a(s: ptr): ptr { ret 0; }

print("=== STRING MARSHALLING REGRESSION ===");

print("--- regression: only-first-char bug ---");
print(len_a("ciao") == 4);
print(len_w("ciao") == 4);
print(len_a_alias("ciao") == 4);
print(len_w_forced_ansi("ciao") != 4);

print("--- two strings in same call (ANSI) ---");
print(cmp_a("alpha", "alpha"));
print((cmp_a("alpha", "beta")) < 0);
print((cmp_a("zeta", "alpha")) > 0);

print("--- two strings in same call (UTF-16) ---");
print(cmp_w("alpha", "alpha"));
print((cmp_w("alpha", "beta")) < 0);
print((cmp_w("zeta", "alpha")) > 0);

print("--- empty string ---");
print(len_a("") == 0);
print(len_w("") == 0);

print("--- long string with spaces and symbols ---");
var long_s = "Hello, World! 1234567890 !@#$%^&*()_+ [test]";
print(len_a(long_s) == 44);
print(len_w(long_s) == 44);

print("--- stability across many calls ---");
var fails = 0;
for (var i = 0; i < 200; i++) {
    var diff = (len_a("ciao") + len_w("ciao")) - 8;
    fails = fails + diff;
}
print(fails == 0);

print("--- mixed types in same call (string + int + ptr) ---");
var buf = native_zero_alloc(64);
var copied = copy_a(buf, "marshal-ok");
print(native_address(copied) != 0);
print(len_a("marshal-ok") == 10);
native_free(buf);

print("--- in-place uppercase via CharUpperA (passes a string-built buffer) ---");
var ws = native_zero_alloc(32);
copy_a(ws, "ciao mondo");
upper_a(ws);
print(native_read_cstr(ws, 0));
native_free(ws);

print("--- explicit overrides still honored ---");
print(len_w_forced_ansi("ciao") == 1);

print("--- different lengths to detect truncation ---");
print(len_a("a") == 1);
print(len_a("ab") == 2);
print(len_a("abc") == 3);
print(len_a("abcd") == 4);
print(len_a("abcdefgh") == 8);
print(len_a("0123456789012345") == 16);

print("=== STRING MARSHALLING PASSED ===");
