print("=== STRING + MATH TESTS ===");

print("--- string basics ---");
print(str_len("hello"));
print(str_upper("hello"));
print(str_lower("HELLO"));
print(str_capitalize("hello world"));
print(str_title("hello world"));
print(str_trim("  hi  "));
print(str_trim_start("  hi  "));
print(str_trim_end("  hi  "));
print(str_split("a,b,c,d", ","));
print(str_join(["a","b","c"], "-"));
print(str_replace("hello", "l", "L"));
print(str_starts_with("hello world", "hello"));
print(str_ends_with("hello world", "world"));
print(str_contains("hello world", "lo w"));
print(str_index_of("hello world", "world"));
print(str_substring("hello world", 6, 11));
print(str_repeat("ab", 4));
print(str_pad_left("7", 3, "0"));
print(str_pad_right("7", 3, "0"));
print(str_reverse("abcde"));
print(str_count("banana", "a"));
print(str_format("Hello, {}! You are {} years old.", "Alice", 30));

print("--- string encoding ---");
print(str_bytes("hi"));
print(str_from_bytes([72, 101, 108, 108, 111]));
print(str_hex_encode("hi"));
print(str_hex_decode("6869"));
print(str_base64_encode("hello"));
print(str_base64_decode("aGVsbG8="));

print("--- regex ---");
print(regex_test("hello123", "\\d+"));
print(regex_match("name: Alice", "name: (\\w+)"));
print(regex_replace("hello world", "world", "Ra"));
print(regex_split("a1b2c3d", "\\d"));
print(regex_find_all("abc123def456", "\\d+"));

print("--- math ---");
print(abs(-7));
print(abs(7));
print(sign(-5));
print(sign(0));
print(sign(5));
print(math_min(3, 7, 1, -4, 2));
print(math_max(3, 7, 1, -4, 2));
print(clamp(15, 0, 10));
print(floor(3.7));
print(ceil(3.2));
print(round(3.5));
print(trunc(3.9));
print(sqrt(64));
print(cbrt(27));
print(pow(2, 10));
print(log(2.718281828));
print(log2(1024));
print(log10(1000));
print(pi());
print(e());
print(tau());
print(is_nan(nan()));
print(is_inf(inf()));
print(is_finite(3.14));
print(gcd(48, 18));
print(lcm(4, 6));
print(factorial(5));

print("--- bit ops ---");
print(bit_count(255));
print(leading_zeros(1));
print(trailing_zeros(8));
print(bit_length(255));
print(rotl(1, 4));
print(rotr(16, 4));

print("--- conversions ---");
print(to_int("42"));
print(to_long("1234567890"));
print(to_double("3.14"));
print(to_string(123));
print(to_bool(1));
print(to_bool(""));
print(parse_int("ff", 16));
print(parse_int("1010", 2));
print(parse_hex("FF"));
print(parse_bin("1010"));
print(parse_float("2.71"));
print(parse_bool("true"));
print(format_hex(255));
print(format_bin(10));
print(format_oct(8));

print("--- str+math passed ---");
