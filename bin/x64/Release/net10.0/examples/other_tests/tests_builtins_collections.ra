print("=== COLLECTION TESTS ===");

print("--- len/empty ---");
print(len([1,2,3,4,5]));
print(len("hello"));
print(len({"a":1, "b":2}));
print(len({1,2,3}));
print(len((1,2)));
print(empty([]));
print(empty([1]));
print(is_not_empty([1]));

print("--- list ops ---");
var l = [1, 2, 3];
list_push(l, 4);
print(l);
print(list_pop(l));
print(l);
list_insert(l, 1, 99);
print(l);
print(list_index_of([10, 20, 30], 20));
print(list_contains([10, 20, 30], 99));
print(list_reverse([1, 2, 3, 4]));
print(list_sort([5, 2, 8, 1, 3]));
print(list_sort_desc([5, 2, 8, 1, 3]));
print(list_unique([1, 1, 2, 3, 3, 4]));
print(list_concat([1, 2], [3, 4], [5]));
print(list_slice([10, 20, 30, 40, 50], 1, 4));
print(list_first([1, 2, 3]));
print(list_last([1, 2, 3]));
print(list_take([1, 2, 3, 4, 5], 3));
print(list_drop([1, 2, 3, 4, 5], 2));
print(list_chunk([1, 2, 3, 4, 5, 6, 7], 3));
print(list_flatten([[1, 2], [3, 4], [5]]));
print(list_zip([1, 2, 3], ["a", "b", "c"]));
print(list_count([1, 2, 1, 3, 1], 1));
print(list_range(0, 5));
print(list_range(0, 10, 2));
print(list_range(5));
print(list_fill(3, "x"));
print(list_repeat([1, 2], 3));
print(list_sum([1, 2, 3, 4, 5]));
print(list_product([1, 2, 3, 4]));
print(list_min([3, 1, 4, 1, 5]));
print(list_max([3, 1, 4, 1, 5]));

print("--- map ops ---");
var m = {"a": 1, "b": 2};
print(map_get(m, "a"));
print(map_get(m, "z"));
print(map_get_or(m, "z", 99));
map_set(m, "c", 3);
print(map_has(m, "c"));
map_remove(m, "a");
print(map_has(m, "a"));
print(map_keys({"x": 10, "y": 20}));
print(map_values({"x": 10, "y": 20}));
print(map_entries({"x": 10, "y": 20}));
print(map_size({"a": 1, "b": 2, "c": 3}));
print(map_merge({"a": 1}, {"b": 2}, {"a": 100}));

print("--- set ops ---");
var s = {1, 2, 3};
set_add(s, 4);
print(set_size(s));
set_remove(s, 1);
print(set_has(s, 1));
print(set_has(s, 4));
print(set_union({1,2,3}, {3,4,5}));
print(set_intersect({1,2,3}, {2,3,4}));
print(set_diff({1,2,3,4}, {2,4}));

print("--- tuple ops ---");
var t = (10, 20, 30);
print(tuple_at(t, 0));
print(tuple_at(t, -1));
print(tuple_size(t));
print(tuple_first((100, 200)));
print(tuple_second((100, 200)));

print("--- factories ---");
print(make_list(1, 2, 3));
print(make_tuple("a", "b", "c"));
print(make_set(1, 2, 2, 3));
print(make_map("a", 1, "b", 2));

print("--- collections passed ---");
