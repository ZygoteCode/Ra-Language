print("=== OS + FS TESTS ===");

print("--- os info ---");
print(os_name());
print(os_arch());
print(os_runtime());
print(os_processor_count());
print(os_is_64bit());
print(os_endian());
print(os_path_sep());

print("--- env ---");
env_set("RA_TEST_VAR", "hello");
print(env_get("RA_TEST_VAR"));
print(env_has("RA_TEST_VAR"));
env_unset("RA_TEST_VAR");
print(env_has("RA_TEST_VAR"));

print("--- cwd ---");
var c = cwd();
print(len(c) > 0);

print("--- fs basic ---");
var tmp = fs_temp_file();
print(fs_exists(tmp));
print(fs_is_file(tmp));
print(fs_is_dir(tmp));

fs_write_text(tmp, "hello world");
print(fs_read_text(tmp));
print(fs_size(tmp));

fs_append_text(tmp, "\nsecond line");
var lines = fs_read_lines(tmp);
print(len(lines));
print(lines / 0);

print("--- fs bytes ---");
fs_write_bytes(tmp, [72, 105]);
print(fs_read_bytes(tmp));
print(fs_read_text(tmp));

print("--- fs paths ---");
print(fs_basename("/foo/bar/baz.txt"));
print(fs_dirname("/foo/bar/baz.txt"));
print(fs_extension("baz.txt"));
print(fs_stem("baz.txt"));
print(fs_change_ext("baz.txt", ".log"));
print(fs_is_absolute(tmp));

print("--- fs mkdir/rmdir ---");
var newdir = tmp + "_dir";
fs_create_dir(newdir);
print(fs_is_dir(newdir));
fs_remove_dir(newdir);
print(fs_is_dir(newdir));

print("--- fs cleanup ---");
fs_remove(tmp);
print(fs_exists(tmp));

print("--- time ---");
var t1 = now_unix_ms();
sleep_ms_blocking(10);
var t2 = now_unix_ms();
print(t2 >= t1 + 9);

print(time_year(now_unix_ms()) >= 2024);
print(monotonic_ns() > 0);

print("--- os+fs passed ---");
