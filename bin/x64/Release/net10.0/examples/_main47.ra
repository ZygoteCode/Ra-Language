pub class Vec2 {
    pub var x: int;
    pub var y: int;

    pub Vec2(x: int, y: int) {
        self.x = x;
        self.y = y;
    }

    pub operator +(other: Vec2): Vec2 {
        ret Vec2(self.x + other.x, self.y + other.y);
    }

    pub operator -(other: Vec2): Vec2 {
        ret Vec2(self.x - other.x, self.y - other.y);
    }

    pub operator *(other: Vec2): Vec2 {
        ret Vec2(self.x * other.x, self.y * other.y);
    }

    pub operator ==(other: Vec2): bool {
        ret self.x == other.x && self.y == other.y;
    }

    pub operator !=(other: Vec2): bool {
        ret self.x != other.x || self.y != other.y;
    }

    pub fn to_string(): string {
        ret "Vec2(" + self.x + ", " + self.y + ")";
    }

    pub operator ==(other: int): bool {
        ret self.x == other && self.y == other;
    }
}

var a = Vec2(1, 2);
var b = Vec2(3, 4);

var c = a + b;
print(c);

var d = a - b;
print(d);

var e = a * b;
print(e);

print(a == b);
print(a != b);

var f = Vec2(1, 2);
print(a == f);

var k: int = 5;
var kk: Vec2 = Vec2(5, 5);
print(kk == k);