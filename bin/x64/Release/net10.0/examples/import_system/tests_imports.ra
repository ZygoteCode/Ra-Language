// ===================== Ra Language Imports Suite =====================

print("=== 1. std.io dotted import ===");
import std.io;
println("hello from std.io");        // -> hello from std.io
print(NEWLINE == "\n");                // -> true


print("=== 2. Relative import-all (string path) ===");
import "imports_helpers/math_lib.ra"; // prints "[math_lib] top-level side effect"
print(add(2, 3));                     // -> 5
print(mul(4, 5));                     // -> 20
print(PI);                             // -> 3.14
print(ask_helper());                   // -> 42


print("=== 3. Cache: re-importing same module does not re-execute it ===");
import "imports_helpers/math_lib.ra"; // must NOT print the side effect again
print(add(7, 8));                     // -> 15


print("=== 4. Alias import (module wrapper) ===");
import "imports_helpers/strings_lib.ra" as strs;
print(strs.repeat("ab", 3));          // -> ababab
print(strs.GREETING);                  // -> hello


print("=== 5. Selective import from relative path ===");
import { repeat } from "imports_helpers/strings_lib.ra";
print(repeat("z", 4));                // -> zzzz


print("=== 6. Selective import from std (dotted form) ===");
import { println } from std.io;
println("selective println works");   // -> selective println works


print("=== 7. Missing relative module produces a ModuleNotFoundError ===");
try {
    import "imports_helpers/does_not_exist.ra";
    print("UNREACHABLE 7");
} catch (e) {
    print("caught missing module");   // -> caught missing module
}


print("=== 8. Missing std module produces a ModuleNotFoundError ===");
try {
    import std.no_such_module;
    print("UNREACHABLE 8");
} catch (e) {
    print("caught missing std");      // -> caught missing std
}


print("=== 9. Circular import is rejected with a clear error ===");
try {
    import "imports_helpers/circle_a.ra";
    print("UNREACHABLE 9");
} catch (e) {
    print("caught circular import");  // -> caught circular import
}


print("=== 10. Private symbols are not exported ===");
try {
    import { internal_helper } from "imports_helpers/math_lib.ra";
    print("UNREACHABLE 10");
} catch (e) {
    print("caught private symbol");   // -> caught private symbol
}


print("=== Imports suite finished ===");
