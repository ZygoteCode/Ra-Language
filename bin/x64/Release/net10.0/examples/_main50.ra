pub trait Named {
    var lol: string;
    fn get_name();
}

pub trait Logger {
    fn log(msg: string) {
        print("[LOG] " + msg);
    }
}

pub abstract class Entity with Logger {
    pub abstract fn id();
    pub abstract var identifier;

    pub fn print_id() {
        self.log("ID: " + self.id());
    }
}

pub abstract class PersonBase : Entity with Named {
    pub var name: string;
    pub var lol: string;

    pub PersonBase(name: string) {
        self.name = name;
    }

    pub fn get_name() {
        ret self.name;
    }
}

pub class Person : PersonBase {
    pub var identifier = 3;

    pub Person(name: string) {
        super(name);
    }

    pub override fn id() {
        ret 5;
    }
}

pub class Father : Person {
    pub override var identifier = 7;

    pub Father(name: string) {
        self.name = name;
    }
}

fn try_it(base: PersonBase) {
    print(base.identifier);
}

fn greet_somebody(val: Entity) {
    print("Hello, " + val.get_name() + "!");
}

var my_person = Person("Gabriele");
my_person.print_id();
print(my_person.get_name());
greet_somebody(my_person);

my_person.identifier = "test";
try_it(my_person);

var my_father = Father("Alessandro");
print(my_father.identifier);