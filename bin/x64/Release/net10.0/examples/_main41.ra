pub trait Named {
    fn get_name();
}

pub trait Logger {
    fn log(msg: string) {
        print("[LOG] " + msg);
    }
}

pub abstract class Entity with Logger {
    pub abstract fn id();

    pub fn print_id() {
        self.log("ID: " + self.id());
    }
}

pub abstract class PersonBase : Entity with Named {
    pub var name: string;

    pub PersonBase(name: string) {
        self.name = name;
    }

    pub fn get_name() {
        ret self.name;
    }
}

pub class Person : PersonBase {
    pub Person(name: string) {
        super(name);
    }

    pub override fn id() {
        ret 5;
    }
}

var my_person = Person("Gabriele");
my_person.print_id();
print(my_person.get_name());