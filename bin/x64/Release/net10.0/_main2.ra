fn oopify(prefix) => prefix + "oop"

fn join(elements, separator) {
	var result = ""
	var length = len(elements)

	for i = 0 to length {
		result = result + elements/i
		if i != length - 1: result = result + separator
	}

	ret result
}

fn map(elements, func) {
	var new_elements = []

	for i = 0 to len(elements) {
    	new_elements = new_elements + func(elements/i)
	}

	{
		i = 7
		i = i + 7
	}

	ret new_elements
}


print("Greetings universe!")

