import std.prelude.*;
// Module that ships its own extension on SharedAmbig. When the
// importer pulls in both this module AND `sealed_owner.ra`, the
// importer's registry holds the seal and refuses this module's
// members at merge time — that's the diagnostic we want.
import "shared.ra";

extend SharedAmbig {
    pub fn rogue_method(): int { ret 99; }
}
