import std.prelude.*;
// Ra Language — borrowing / ownership / lifetimes regression suite.
//
// Each case prints "[<id>] OK" on success or "[<id>] FAIL: <details>".
// Covers the new let/let mut/let const grammar and the &/&mut/* borrow surface.
// Legacy var / final / const remain available and are spot-checked here for
// no-regression.

print("=== Ra Borrow / Ownership / Lifetime Tests ===");

// --------------------------------------------------------------------------
// Group A — let, let mut, let const declaration & assignment rules
// --------------------------------------------------------------------------

// [A1] let binds immutable; reassignment is rejected.
let a1 = 10;
if a1 == 10 { print("[A1a] OK"); } else { print("[A1a] FAIL"); }
try {
    a1 = 20;
    print("[A1b] FAIL: let was reassignable");
} catch (e) {
    print("[A1b] OK");
}

// [A2] let mut binds mutable; reassignment works.
let mut a2 = 1;
a2 = 2;
a2 = 3;
if a2 == 3 { print("[A2] OK"); } else { print("[A2] FAIL a2=" + (a2 as string)); }

// [A3] let const is immutable AND must be initialised.
let const a3 = 99;
try {
    a3 = 100;
    print("[A3a] FAIL: let const was reassignable");
} catch (e) {
    print("[A3a] OK");
}
// repeated reads of a let const are fine (treated as compile-time stable).
if a3 + a3 == 198 { print("[A3b] OK"); } else { print("[A3b] FAIL"); }

// [A4] Legacy var / const / final still behave classically (no regression).
var a4 = 1;
a4 = 2;
if a4 == 2 { print("[A4a] OK"); } else { print("[A4a] FAIL"); }
const a4b = 5;
try {
    a4b = 6;
    print("[A4b] FAIL: const was reassignable");
} catch (e) {
    print("[A4b] OK");
}
final a4c = 7;
try {
    a4c = 8;
    print("[A4c] FAIL: final was reassignable after init");
} catch (e) {
    print("[A4c] OK");
}

// --------------------------------------------------------------------------
// Group B — shared borrows (&x)
// --------------------------------------------------------------------------

// [B1] shared borrow reads underlying value via *.
let mut b1 = 42;
{
    let r = &b1;
    if *r == 42 { print("[B1] OK"); } else { print("[B1] FAIL *r=" + (*r as string)); }
}

// [B2] multiple shared borrows are allowed simultaneously.
let mut b2 = 5;
{
    let r1 = &b2;
    let r2 = &b2;
    let r3 = &b2;
    if (*r1) + (*r2) + (*r3) == 15 { print("[B2] OK"); } else { print("[B2] FAIL"); }
}

// [B3] mutation of source is blocked while shared borrows are alive.
let mut b3 = 1;
{
    let r = &b3;
    try {
        b3 = 99;
        print("[B3] FAIL: mutated while &b3 alive");
    } catch (e) {
        print("[B3] OK");
    }
}

// [B4] borrow goes out of scope -> source is mutable again.
let mut b4 = 1;
{
    let r = &b4;
}
b4 = 50;
if b4 == 50 { print("[B4] OK"); } else { print("[B4] FAIL b4=" + (b4 as string)); }

// --------------------------------------------------------------------------
// Group C — mutable borrows (&mut x)
// --------------------------------------------------------------------------

// [C1] &mut allows mutation through the borrow.
let mut c1 = 7;
{
    let r = &mut c1;
    *r = 33;
}
if c1 == 33 { print("[C1] OK"); } else { print("[C1] FAIL c1=" + (c1 as string)); }

// [C2] cannot have two &mut at once.
let mut c2 = 1;
{
    let r1 = &mut c2;
    try {
        let r2 = &mut c2;
        print("[C2] FAIL: two &mut allowed");
    } catch (e) {
        print("[C2] OK");
    }
}

// [C3] cannot mix & and &mut.
let mut c3 = 1;
{
    let s = &c3;
    try {
        let m = &mut c3;
        print("[C3] FAIL: &mut while & alive");
    } catch (e) {
        print("[C3] OK");
    }
}

// [C4] cannot read source directly while &mut alive.
let mut c4 = 7;
{
    let m = &mut c4;
    try {
        var sneak = c4;
        print("[C4] FAIL: read while &mut");
    } catch (e) {
        print("[C4] OK");
    }
}

// [C5] cannot &mut an immutable let binding.
let c5 = 5;
try {
    let r = &mut c5;
    print("[C5] FAIL: &mut on immutable let");
} catch (e) {
    print("[C5] OK");
}

// [C6] cannot &mut a let const binding.
let const c6 = 5;
try {
    let r = &mut c6;
    print("[C6] FAIL: &mut on let const");
} catch (e) {
    print("[C6] OK");
}

// [C7] cannot &mut a const binding.
const c7 = 5;
try {
    let r = &mut c7;
    print("[C7] FAIL: &mut on const");
} catch (e) {
    print("[C7] OK");
}

// [C8] cannot &mut a final binding.
final c8 = 5;
try {
    let r = &mut c8;
    print("[C8] FAIL: &mut on final");
} catch (e) {
    print("[C8] OK");
}

// --------------------------------------------------------------------------
// Group D — deref + write
// --------------------------------------------------------------------------

// [D1] reading through shared borrow yields the value.
let mut d1 = 99;
{
    let r = &d1;
    var copy = *r;
    if copy == 99 { print("[D1] OK"); } else { print("[D1] FAIL copy=" + (copy as string)); }
}

// [D2] dereferencing a non-reference errors out.
var d2 = 5;
try {
    var bad = *d2;
    print("[D2] FAIL: deref of non-reference accepted");
} catch (e) {
    print("[D2] OK");
}

// --------------------------------------------------------------------------
// Group E — borrow rebind on let mut holding a borrow
// --------------------------------------------------------------------------

// [E1] reassigning a let mut that holds a borrow swaps the borrow target.
let mut e1a = 10;
let mut e1b = 20;
{
    let mut r = &e1a;
    if *r == 10 { print("[E1a] OK"); } else { print("[E1a] FAIL"); }
    r = &e1b;
    if *r == 20 { print("[E1b] OK"); } else { print("[E1b] FAIL"); }
}
// after rebind + scope exit, both sources are unborrowed.
e1a = 100;
e1b = 200;
if e1a == 100 and e1b == 200 { print("[E1c] OK"); } else { print("[E1c] FAIL"); }

// --------------------------------------------------------------------------
// Group F — lifetime + ref-type annotations parse cleanly
// --------------------------------------------------------------------------

// [F1] lifetime in generic params and ref-type annotation in a function.
fn identity_ref<'a>(x: &'a int): int {
    ret *x;
}
let f1 = 7;
{
    let r = &f1;
    var got = identity_ref(r);
    if got == 7 { print("[F1] OK"); } else { print("[F1] FAIL got=" + (got as string)); }
}

// --------------------------------------------------------------------------
// Group G — coexistence with the legacy interface
// --------------------------------------------------------------------------

// [G1] legacy var assignment unaffected by borrow checker when no borrows are taken.
var g1 = 1;
g1 = g1 + 1;
g1 = g1 + 1;
if g1 == 3 { print("[G1] OK"); } else { print("[G1] FAIL g1=" + (g1 as string)); }

// [G2] legacy final still allows first init and blocks reassign.
final g2 = 4;
try {
    g2 = 5;
    print("[G2] FAIL: final reassigned");
} catch (e) {
    print("[G2] OK");
}

print("=== Done ===");
