// Ra Language - numbers: float specials (inf / nan).
//
// Probed facts (Ra v.current):
//   * inf() yields +Infinity (a double); nan() yields NaN; neg(x) negates.
//   * is_inf / is_nan / is_finite are the predicate builtins.
//   * NaN != NaN is true; NaN == NaN is false (IEEE semantics preserved).
//   * is_nan(nan()) true; is_inf(inf()) true; is_finite(inf()) false;
//     is_finite(nan()) false; is_finite(<finite>) true.
//
// !! IMPORTANT BUG / LIMITATION (see returned notes):
//   Performing ANY arithmetic OR comparison with an infinite operand
//   (e.g. `inf() + 1`, `1.0 / inf()`, `inf() > 1.0`) HARD-CRASHES the
//   interpreter (process exits 1) and is NOT catchable by try/catch.
//   Those cases are therefore intentionally omitted here — exercising them
//   would make this regression file un-runnable. The task's requested
//   "inf+1==inf" / "1/inf" probes are dropped for this reason.
//
// Cases:
//   S1   inf() is infinite, not finite
//   S2   inf() is not NaN
//   S3   nan() is NaN
//   S4   nan() is not infinite, not finite
//   S5   NaN != NaN  (true)  and  NaN == NaN  (false)
//   S6   neg(inf()) is still infinite
//   S7   neg(inf()) differs from inf() (sign flipped) but both is_inf
//   S8   a finite double is finite and neither inf nor nan
//   S9   very large finite magnitude (1e308 literal) is finite
//   S10  very small finite magnitude (1e-308 literal) is finite and > 0
//   S11  is_nan/is_inf return false on an ordinary integer
//   S12  nan() round-trips through a let-bound variable as still NaN

fn ok(id, cond) { if cond { print("[" + id + "] OK"); } else { print("[" + id + "] FAIL"); } }

print("=== numbers/float_specials ===");

var pinf = inf();
ok("S1", is_inf(pinf) and is_finite(pinf) == false);

ok("S2", is_nan(pinf) == false);

var n = nan();
ok("S3", is_nan(n));

ok("S4", is_inf(n) == false and is_finite(n) == false);

ok("S5", (n != n) and (n == n) == false);

var ninf = neg(inf());
ok("S6", is_inf(ninf));

// Sign-flipped infinity: both report is_inf, equality test avoided
// (comparing infinities crashes), so compare their string forms instead.
ok("S7", is_inf(ninf) and is_inf(pinf) and (ninf as string) != (pinf as string));

var f = 3.5;
ok("S8", is_finite(f) and is_inf(f) == false and is_nan(f) == false);

var big = 1.0e308;
ok("S9", is_finite(big));

var tiny = 1.0e-308;
ok("S10", is_finite(tiny) and tiny > 0);

ok("S11", is_nan(42) == false and is_inf(42) == false);

let keep = nan();
ok("S12", is_nan(keep));

print("=== done ===");
