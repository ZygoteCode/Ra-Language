import std.prelude.*;
// Ra Language - numbers: int128 / uint128 typed declarations.
//
// Cases:
//   I1   int128 binds an integer literal
//   I2   uint128 binds an integer literal
//   I3   arithmetic stays in int128 range
//   I4   uint128 large literal preserves value

print("=== numbers/int128 ===");

try {
    var a: int128 = 42;
    if a == 42 { print("[I1] OK"); } else { print("[I1] FAIL " + (a as string)); }
} catch (ex) { print("[I1] FAIL: " + ex); }

try {
    var b: uint128 = 99;
    if b == 99 { print("[I2] OK"); } else { print("[I2] FAIL " + (b as string)); }
} catch (ex) { print("[I2] FAIL: " + ex); }

try {
    var a: int128 = 100;
    var c = a + 50;
    if c == 150 { print("[I3] OK"); } else { print("[I3] FAIL " + (c as string)); }
} catch (ex) { print("[I3] FAIL: " + ex); }

try {
    var d: uint128 = 1000000;
    if d == 1000000 { print("[I4] OK"); } else { print("[I4] FAIL " + (d as string)); }
} catch (ex) { print("[I4] FAIL: " + ex); }

print("=== done ===");
