import std.prelude.*;
// Ra Language - collections: slicing & range indexing on lists.
//
// Cases:
//   S1   l[1..3] exclusive
//   S2   l[1..=3] inclusive
//   S3   stride l[0..=6:2]
//   S4   multi-index l[[1, 3]]
//   S5   slice assignment l[1..3] = v
//   S6   slice out-of-bounds tolerated or errored

print("=== collections/slicing ===");

var l = [10, 20, 30, 40, 50, 60, 70, 80, 90];

try {
    var a = l[1..3];
    if len(a) == 2 and a[0] == 20 and a[1] == 30 { print("[S1] OK"); } else { print("[S1] FAIL " + (a as string)); }
} catch (ex) { print("[S1] FAIL: " + ex); }

try {
    var a = l[1..=3];
    if len(a) == 3 and a[0] == 20 and a[2] == 40 { print("[S2] OK"); } else { print("[S2] FAIL " + (a as string)); }
} catch (ex) { print("[S2] FAIL: " + ex); }

try {
    var a = l[0..=6:2];
    if len(a) == 4 and a[0] == 10 and a[1] == 30 { print("[S3] OK"); } else { print("[S3] FAIL " + (a as string)); }
} catch (ex) { print("[S3] FAIL: " + ex); }

try {
    var a = l[[1, 3]];
    if a[0] == 20 and a[1] == 40 { print("[S4] OK"); } else { print("[S4] FAIL " + (a as string)); }
} catch (ex) { print("[S4] FAIL: " + ex); }

try {
    var m = [10, 20, 30, 40, 50];
    m[1..3] = 99;
    print("[S5] OK m=" + (m as string));
} catch (ex) { print("[S5] FAIL: " + ex); }

print("=== done ===");
