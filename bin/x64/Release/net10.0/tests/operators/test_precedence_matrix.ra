import std.prelude.*;
// Ra Language -- operator precedence & associativity matrix.
//
// Proves the binding order and associativity of the operator ladder across
// mixed expressions. Every case asserts a SEMANTICALLY-CORRECT value derived
// from the verified runtime behaviour (probed against the interpreter).
//
// Precedence summary proven below (tightest -> loosest):
//   ^ (pow, RIGHT-assoc)  >  unary - / !  >  * / %  >  + -  >  << >> ...
//   >  comparison (< > <= >= == != === !==)  >  bitwise & | ~  >  && >  ||
//   >  ?? > ?: (ternary)
//
// NOTE on a couple of surprises pinned down by probing this build:
//   * unary minus binds LOOSER than `^`:  -2 ^ 2  ==  -(2^2)  == -4
//   * `==` binds TIGHTER than bitwise `|`: `1 | 2 == 3` parses as
//     `1 | (2 == 3)` -> illegal -> throws (asserted in P22).
//   * comparison operators do NOT chain: `1 < 2 < 3` throws (asserted P23).

fn ok(id, cond) {
    if cond {
        print("[" + id + "] OK")
    } else {
        print("[" + id + "] FAIL")
    }
}

print("=== operators/precedence_matrix ===")

// --- arithmetic precedence: * / % bind tighter than + -
ok("P1", (2 + 3 * 4) == 14);
ok("P2", ((2 + 3) * 4) == 20);
ok("P3", (2 * 3 + 4) == 10);
ok("P4", (20 - 2 * 5) == 10);
ok("P5", (10 + 6 / 2) == 13);
ok("P6", (10 % 4 + 1) == 3);
ok("P7", (2 * 3 % 4) == 2);

// --- power: right-associative, and looser-binding unary minus
ok("P8", (2 ^ 3 ^ 2) == 512);
ok("P9", ((2 ^ 3) ^ 2) == 64);
ok("P10", (-2 ^ 2) == -4);
ok("P11", ((-2) ^ 2) == 4);
ok("P12", (2 * 3 ^ 2) == 18);

// --- left-associativity proofs for - / %
ok("P13", (10 - 3 - 2) == 5);
ok("P14", (100 / 5 / 2) == 10);
ok("P15", (17 % 7 % 3) == 0);

// --- comparison sits below arithmetic
ok("P16", (1 + 1 == 2) == true);
ok("P17", (2 * 3 > 5) == true);
ok("P18", (1 < 2 and 2 < 3) == true);

// --- logical: && tighter than ||
ok("P19", (true || false && false) == true);
ok("P20", (false && false || true) == true);
ok("P21", (false && (false || true)) == false);

// --- bitwise OR is LOOSER than == (probed): `1 | 2 == 3` => `1 | (2==3)` throws
var p22_threw = false
try {
    var _bad = 1 | 2 == 3
    p22_threw = false
} catch (e) {
    p22_threw = true
}
ok("P22", p22_threw);
ok("P22b", ((1 | 2) == 3) == true);

// --- comparison operators do NOT chain (probed): `1 < 2 < 3` throws
var p23_threw = false
try {
    var _c = 1 < 2 < 3
    p23_threw = false
} catch (e) {
    p23_threw = true
}
ok("P23", p23_threw);

// --- ternary & null-coalesce precedence
// `??` binds TIGHTER than `?:`: null ?? false ? "A":"B" == (null??false)?"A":"B"
var p24 = null ?? false ? "A" : "B"
ok("P24", p24 == "B");
// ternary is right-associative through the else branch
var p25 = false ? "x" : true ? "y" : "z"
ok("P25", p25 == "y");
var p26 = true ? "first" : false ? "y" : "z"
ok("P26", p26 == "first");
// `??` chains left-to-right, stops at first non-null
ok("P27", (null ?? null ?? 3) == 3);
ok("P28", (null ?? 7 ?? 9) == 7);

// --- shift precedence: + below << (matches RA_SHIFTS_DESIGN)
ok("P29", (1 + 2 << 3) == 24);
ok("P30", (16 >> 1 >> 1) == 4);
ok("P31", (1 << 3 >> 1) == 4);

// --- not / ! binds tighter than and/or
ok("P32", (not false and true) == true);
ok("P33", (!false && true) == true);
ok("P34", (not (false and true)) == true);

// --- mixed mega-expressions
// 2 + 3 * 4 ^ 2 - 1  ->  2 + 3*(4^2) - 1 = 2 + 48 - 1 = 49
ok("P35", (2 + 3 * 4 ^ 2 - 1) == 49);
ok("P36", ((1 + 1 == 2) and (2 * 2 == 4)) == true);

print("=== done ===")
