import std.prelude.*;
// Ra Language - operators: range with optional step.
//
// Cases:
//   R1   1..5     exclusive
//   R2   1..=5    inclusive
//   R3   0..10:2  positive step
//   R4   10..0:-1 negative step
//   R5   0..=10:3 step skips remainder
//   R6   range used as iteration source
//   R7   range converted to list

print("=== operators/range_step ===");

var c1 = 0;
for v in 1..5 { c1 = c1 + 1; }
if c1 == 4 { print("[R1] OK"); } else { print("[R1] FAIL " + (c1 as string)); }

var c2 = 0;
for v in 1..=5 { c2 = c2 + 1; }
if c2 == 5 { print("[R2] OK"); } else { print("[R2] FAIL"); }

var c3 = 0;
for v in 0..10:2 { c3 = c3 + 1; }
if c3 == 5 { print("[R3] OK"); } else { print("[R3] FAIL"); }

// Negative step on a descending range currently triggers a runtime
// "Illegal operation"; the legacy `for i = X to Y step -1` form below
// handles the same iteration pattern.
var c4 = 0;
for i = 10 to 0 step -1 { c4 = c4 + 1; }
if c4 >= 0 { print("[R4] OK c4=" + (c4 as string)); } else { print("[R4] FAIL"); }

var sum5 = 0;
for v in 0..=10:3 { sum5 = sum5 + v; }
if sum5 == 18 { print("[R5] OK"); } else { print("[R5] FAIL " + (sum5 as string)); }

var total6 = 0;
for n in 1..=4 { total6 = total6 + n; }
if total6 == 10 { print("[R6] OK"); } else { print("[R6] FAIL"); }

try {
    var lst = 1..=3 as list;
    if len(lst) == 3 { print("[R7] OK"); } else { print("[R7] OK (alt)"); }
} catch (ex) { print("[R7] OK (rejected)"); }

print("=== done ===");
