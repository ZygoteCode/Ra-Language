import std.prelude.*;
// Ra Lambdas -- bar-style anonymous functions test suite.
// Every test prints "[LNN] OK" on success.

// ----- L1: zero-arg, expression body -----
let answer = || 42
print(answer())
print("[L1] OK")

// ----- L2: zero-arg via separated bars `| |` -----
let other = | | 99
print(other())
print("[L2] OK")

// ----- L3: single-param, expression body -----
let inc = |x| x + 1
print(inc(10))
print(inc(-1))
print("[L3] OK")

// ----- L4: multi-param -----
let add3 = |a, b, c| a + b + c
print(add3(1, 2, 3))
print("[L4] OK")

// ----- L5: typed parameters -----
let mul: fn(int, int) -> int = |a: int, b: int| a * b
print(mul(6, 7))
print("[L5] OK")

// ----- L6: typed parameters AND return type -----
let div: fn(int, int) -> int = |a: int, b: int| -> int a / b
print(div(20, 4))
print("[L6] OK")

// ----- L7: block body -----
let abs_int = |x: int| -> int {
    if x < 0 { ret -x }
    ret x
}
print(abs_int(-7))
print(abs_int(13))
print("[L7] OK")

// ----- L8: implicit closure capture -----
let base_ = 100
let with_cap = |x| x + base_
print(with_cap(1))
print(with_cap(2))
print("[L8] OK")

// ----- L9: explicit ByValue capture (snapshot) -----
var counter = 10
let snap = [counter] || counter
print(snap())
counter = 999
print(snap())
print("[L9] OK")

// ----- L10: explicit ByRef capture (shared, read-only via deref) -----
var seen = 7
let observe = [&seen] || *seen
print(observe())
print(observe())
print("[L10] OK")

// ----- L11: lambdas as first-class arguments (higher-order) -----
fn map_list(xs: list, f: fn(int) -> int): list {
    var out = []
    for i = 0 to len(xs) step 1 {
        list_push(out, f(xs[i]))
    }
    ret out
}
print(map_list([1, 2, 3, 4], |x| x * 2))
print(map_list([10, 20, 30], |x| x - 5))
print("[L11] OK")

// ----- L12: lambda returned from a function (closure factory) -----
fn make_adder(n: int): fn(int) -> int { ret |x| x + n }
let add10 = make_adder(10)
let add25 = make_adder(25)
print(add10(5))
print(add25(5))
print("[L12] OK")

// ----- L13: nested lambdas (currying) -----
let curry = |a| |b| |c| a + b + c
print(curry(1)(2)(3))
print("[L13] OK")

// ----- L14: lambda body holds a control-flow expression (ternary chain) -----
let sign = |x| x > 0 ? 1 : (x < 0 ? (-1) : 0)
print(sign(7))
print(sign(0))
print(sign(-3))
print("[L14] OK")

// ----- L15: lambda body is a ternary -----
let classify = |x| x > 0 ? "pos" : (x < 0 ? "neg" : "zero")
print(classify(5))
print(classify(0))
print(classify(-5))
print("[L15] OK")

// ----- L16: lambda mutates a captured (&mut) variable via deref -----
var hits = 0
let bump = [&mut hits] || -> int { *hits = *hits + 1; ret *hits }
print(bump())
print(bump())
print(bump())
print("[L16] OK")

// ----- L17: lambda passed to compose() and partial() -----
let times3 = |x: int| -> int x * 3
let plus7  = |x: int| -> int x + 7
let pipe   = compose(times3, plus7)
print(pipe(4))
let plus10 = partial(|a: int, b: int| -> int a + b, 10)
print(plus10(5))
print("[L17] OK")

// ----- L18: lambdas combine via delegate `+` (multicast) -----
fn h_a(x: int) { print($"a:${x}") }
let h_lam = |x: int| { print($"lam:${x}") }
var bus = h_a
bus = bus + h_lam
bus(42)
print(handler_count(bus))
print("[L18] OK")

// ----- L19: recursion via Y-style self-pass (ternary body) -----
let fact = |self_, n| n <= 1 ? 1 : n * self_(self_, n - 1)
print(fact(fact, 5))
print(fact(fact, 7))
print("[L19] OK")

// ----- L20: lambdas inside loops keep distinct captures -----
let bumpers = []
for k = 0 to 3 step 1 {
    list_push(bumpers, [k] |x| x + k)
}
print(bumpers[0](100))
print(bumpers[1](100))
print(bumpers[2](100))
print("[L20] OK")

// ----- L21: list-literal vs capture-clause disambiguation -----
let xs = [1, 2, 3]
let pick = |i| xs[i]
print(pick(0))
print(pick(2))
let cap_lam = [xs] |i| xs[i]
print(cap_lam(1))
print("[L21] OK")

// ----- L22: empty capture clause `[] |...|` -----
let pure_ = [] |a, b| a + b
print(pure_(3, 4))
print("[L22] OK")

// ----- L23: lambda assigned to a structural fn slot via target typing -----
let pred: fn(int) -> bool = |x| x > 0
print(pred(5))
print(pred(-1))
print("[L23] OK")

// ----- L24: lambda used directly at the call site (IIFE) -----
print((|x| x * x)(11))
print((|| 7)())
print("[L24] OK")

// ----- L25: lambda nested deep inside a block lambda -----
let outer = |a| {
    let inner = |b| a * b + 1
    ret inner(a) + inner(a + 1)
}
print(outer(3))
print("[L25] OK")

// ----- L26: lambda over a fn-typed parameter passed to higher-order -----
fn invoke_with_seven(f: fn(int) -> int): int { ret f(7) }
print(invoke_with_seven(|x| x + 1))
print(invoke_with_seven(|x: int| x * x))
print("[L26] OK")

// ----- L27: lambda body with multiple statements (block) -----
let stats = |xs: list| {
    var s = 0
    var n = 0
    for i = 0 to len(xs) step 1 {
        s = s + xs[i]
        n = n + 1
    }
    ret (s, n)
}
let r = stats([10, 20, 30, 40])
print(r)
print("[L27] OK")

// ----- L28: lambda choosing another lambda (ternary body) -----
let pickFn = |flag| flag ? (|x| x + 1) : (|x| x - 1)
let upper = pickFn(true)
let lower = pickFn(false)
print(upper(10))
print(lower(10))
print("[L28] OK")

// ----- L29: capture mix -- ByValue snapshot + ByRef shared via deref -----
var snap_src = 1
var live_src = 41
let mixed = [snap_src, &live_src] || snap_src + *live_src
print(mixed())
snap_src = 100
print(mixed())
print("[L29] OK")

// ----- L30: lambda assigned to a generic-typed delegate alias -----
delegate Mapper<T, U> = fn(T) -> U
let stringify: Mapper<int, string> = |n: int| -> string $"n=${n}"
print(stringify(42))
print("[L30] OK")

print("ALL LAMBDA TESTS DONE")
