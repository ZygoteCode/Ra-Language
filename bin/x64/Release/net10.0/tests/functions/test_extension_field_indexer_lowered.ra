import std.prelude.*;
// L10: extension-block FIELDS (`extend T { var f: ... = const }`) and INDEXERS
// (`op_index` / `op_index_set`) now lower. Ext fields reuse the struct-field flat
// capture (const default folds; non-const / lazy fall back). Ext indexers are
// ordinary op_index / op_index_set methods → they reuse the extension-METHOD body
// IR entirely (IndexerDef just re-points at the reconstructed method). .rac v9.
print("=== functions/extension_field_indexer_lowered ===");

var failures = 0;
fn ck(label: string, cond: bool) {
    if cond { print(label + " OK"); } else { print(label + " FAIL"); failures = failures + 1; }
}

// EF1: extension field with a const default + read/write.
pub struct V { pub var n: int; pub V(n: int) { self.n = n; } }
extend V {
    pub var tag: string = "base"
    pub var bonus: int = 7
}
let v = V(5);
ck("[EF1a]", v.tag == "base" and v.bonus == 7);   // defaults applied
v.tag = "hi";
ck("[EF1b]", v.tag == "hi");

// EF2: extension indexer get + set on a class (set propagates).
pub class Grid { pub var w: int; pub Grid(w: int) { self.w = w; } }
extend Grid {
    pub fn op_index(i: int): int { ret self.w + i; }
    pub fn op_index_set(i: int, value: int) { self.w = value - i; }
}
let g = Grid(10);
ck("[EF2a]", g[5] == 15);          // 10 + 5
g[2] = 20;                         // self.w = 20 - 2 = 18
ck("[EF2b]", g.w == 18 and g[0] == 18);

if failures == 0 { print("=== done ==="); } else { print("=== FAIL (" + (failures as string) + ") ==="); }
