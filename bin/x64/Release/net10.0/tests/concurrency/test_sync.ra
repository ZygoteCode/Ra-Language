import std.prelude.*;
print("=== Ra Spawn / Sync Safety Tests ===");

// [S2] Sync types pass through fine: spawning with an immutable scalar arg.
async fn double(n) => n * 2;
let t2 = spawn double(7);
let v2 = await t2;
if v2 == 14: print("[S2] OK") else: print("[S2] FAIL got " + v2);

// [S3] Channels are Sync (thread-safe by design). spawn(channel_send) works.
let ch = channel(4);
async fn writer(c, v) => channel_send(c, v);
let tw = spawn writer(ch, 42);
let _ = await tw;
let got = channel_recv(ch);
if got == 42: print("[S3] OK") else: print("[S3] FAIL got " + got);

print("[S1] (skipped at runtime: would emit the documented spawn-boundary error — see tests_sync_negative.ra)");

print("=== Done ===");
