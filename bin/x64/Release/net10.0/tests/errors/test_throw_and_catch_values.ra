import std.prelude.*;
// Ra Language - errors: throwing and catching values of every kind.
//
// The catch binding `catch (e)` binds the thrown value itself, so the handler
// can inspect it (string compare, arithmetic, field access).
//
// Cases:
//   V1   throw a string -> catch binding equals it
//   V2   throw a number -> catch binding usable in arithmetic
//   V3   throw a bool -> catch binding equals it
//   V4   throw a struct/object -> catch reads its fields
//   V5   throw a list -> catch indexes/length it
//   V6   re-throw a TRANSFORMED value from inner catch -> outer catch sees it
//   V7   throw inside a called function -> caught at the call site
//   V8   re-throw the same binding unchanged -> outer sees original value
//   V9   caught throw means the program CONTINUES (uncaught would abort);
//        prove by reaching a post-try statement
//   V10  selective handling: catch inspects value and decides path

print("=== errors/throw_and_catch_values ===");

fn ok(id: string, cond: bool) {
    if cond { print("[" + id + "] OK"); } else { print("[" + id + "] FAIL"); }
}

// V1: string payload.
var v1 = "";
try {
    throw "the-message";
} catch (e) {
    v1 = e;
}
ok("V1", v1 == "the-message");

// V2: numeric payload survives as a number.
var v2 = 0;
try {
    throw 21;
} catch (e) {
    v2 = e * 2;
}
ok("V2", v2 == 42);

// V3: bool payload.
var v3 = false;
try {
    throw true;
} catch (e) {
    v3 = e;
}
ok("V3", v3 == true);

// V4: struct payload, fields readable in the handler.
struct AppError {
    pub var code: int;
    pub var msg: string;
    pub AppError(c: int, m: string) {
        self.code = c;
        self.msg = m;
    }
}
var v4code = 0;
var v4msg = "";
try {
    throw AppError(404, "not found");
} catch (e) {
    v4code = e.code;
    v4msg = e.msg;
}
ok("V4", v4code == 404 and v4msg == "not found");

// V5: list payload.
var v5 = 0;
try {
    throw [5, 6, 7];
} catch (e) {
    v5 = e[0] + len(e);
}
ok("V5", v5 == 8);

// V6: re-throw a transformed value across two levels.
var v6 = "";
try {
    try {
        throw "base";
    } catch (inner) {
        throw inner + "-wrapped";
    }
} catch (outer) {
    v6 = outer;
}
ok("V6", v6 == "base-wrapped");

// V7: throw inside a called function bubbles to the caller's try.
fn risky(n: int): int {
    if n < 0 { throw "negative input"; }
    ret n * 10;
}
var v7caught = "";
var v7val = 0;
try {
    v7val = risky(-1);
} catch (e) {
    v7caught = e;
}
ok("V7", v7caught == "negative input" and v7val == 0 and risky(3) == 30);

// V8: re-throw the SAME binding unchanged; outer must see the original.
var v8 = 0;
try {
    try {
        throw 99;
    } catch (e) {
        throw e;
    }
} catch (e2) {
    v8 = e2;
}
ok("V8", v8 == 99);

// V9: a caught throw does not abort the program -- post-try code runs.
var v9before = false;
var v9after = false;
try {
    v9before = true;
    throw "stop";
} catch (e) {
    pass;
}
v9after = true;
ok("V9", v9before and v9after);

// V10: handler inspects the payload and branches on it.
fn handle(payload: AppError): string {
    var label = "";
    try {
        throw payload;
    } catch (e) {
        if e.code >= 500 { label = "server"; } else { label = "client"; }
    }
    ret label;
}
ok("V10", handle(AppError(500, "boom")) == "server" and handle(AppError(400, "bad")) == "client");

print("=== done ===");
