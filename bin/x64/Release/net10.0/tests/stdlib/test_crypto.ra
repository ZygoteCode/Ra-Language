import std.prelude.*;
// stdlib/crypto — hashing / HMAC / checksum, checked against known vectors.

fn ok(id, cond) {
    if cond { print("[" + id + "] OK"); } else { print("[" + id + "] FAIL"); }
}

print("=== stdlib/crypto ===");

ok("C1", sha256_hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
ok("C2", sha256_hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
ok("C3", sha1_hex("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d");
ok("C4", md5_hex("abc") == "900150983cd24fb0d6963f7d28e17f72");
ok("C5", sha512_hex("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
ok("C6", crc32("") == 0);
ok("C7", crc32("hello") == 907060870);
ok("C8", hmac_sha256_hex("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8");
ok("C9", sha256_hex("determinism") == sha256_hex("determinism"));
ok("C10", len(sha256_hex("x")) == 64);

print("=== done ===");
