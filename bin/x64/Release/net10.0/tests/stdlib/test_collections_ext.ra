import std.prelude.*;
// stdlib/collections_ext — structural reshapers and key-driven HOFs added
// to std.prelude.collections (list_windows, intersperse, list_rotate,
// find_last, count_by, distinct_by, scan).

fn ok(id, cond) {
    if cond { print("[" + id + "] OK"); } else { print("[" + id + "] FAIL"); }
}

print("=== stdlib/collections_ext ===");

// --- list_windows -------------------------------------------------------
var w = list_windows([1, 2, 3, 4], 2);
ok("WIN1", len(w) == 3);
ok("WIN2", w[0][0] == 1 and w[0][1] == 2);
ok("WIN3", w[2][1] == 4);
ok("WIN4", len(list_windows([1, 2], 5)) == 0);     // window larger than list
var werr = false;
try { list_windows([1, 2, 3], 0); werr = false; } catch (e) { werr = true; }
ok("WIN5", werr);

// --- intersperse --------------------------------------------------------
var it = intersperse([1, 2, 3], 0);
ok("INT1", len(it) == 5);
ok("INT2", it[1] == 0 and it[3] == 0);
ok("INT3", len(intersperse([], 9)) == 0);
ok("INT4", len(intersperse([7], 9)) == 1);

// --- list_rotate (left; negative = right) -------------------------------
var ro = list_rotate([1, 2, 3, 4, 5], 2);
ok("ROT1", ro[0] == 3 and ro[4] == 2);
var rn = list_rotate([1, 2, 3], 0 - 1);
ok("ROT2", rn[0] == 3);
ok("ROT3", len(list_rotate([], 3)) == 0);
ok("ROT4", list_rotate([1, 2, 3], 3)[0] == 1);     // full turn

// --- find_last ----------------------------------------------------------
ok("FL1", find_last([1, 2, 3, 4], |x| x % 2 == 0) == 4);
ok("FL2", find_last([1, 3, 5], |x| x % 2 == 0) == null);

// --- count_by (frequency map) -------------------------------------------
var cb = count_by([1, 2, 3, 4, 5, 6], |x| x % 3);
ok("CB1", map_get(cb, 0) == 2);
ok("CB2", map_get(cb, 1) == 2);
ok("CB3", map_get(cb, 2) == 2);

// --- distinct_by (first wins per key) -----------------------------------
var db = distinct_by([1, 2, 3, 4, 5, 6], |x| x % 3);
ok("DB1", len(db) == 3);
ok("DB2", db[0] == 1 and db[1] == 2 and db[2] == 3);

// --- scan (running fold, keeps the seed) --------------------------------
var sc = scan([1, 2, 3, 4], 0, |a, b| a + b);
ok("SC1", len(sc) == 5);
ok("SC2", sc[0] == 0);
ok("SC3", sc[4] == 10);
ok("SC4", len(scan([], 100, |a, b| a + b)) == 1);  // just the seed

print("=== done ===");
