import std.prelude.*;
// stdlib/time_ext — calendar helpers added to std.prelude.time.

fn ok(id, cond) {
    if cond { print("[" + id + "] OK"); } else { print("[" + id + "] FAIL"); }
}

print("=== stdlib/time_ext ===");

// --- leap years (Gregorian rule) ----------------------------------------
ok("L1", is_leap_year(2000));         // /400
ok("L2", is_leap_year(1900) == false); // /100 not /400
ok("L3", is_leap_year(2024));         // /4
ok("L4", is_leap_year(2023) == false);

// --- days in month ------------------------------------------------------
ok("D1", days_in_month(2024, 2) == 29);   // leap February
ok("D2", days_in_month(2023, 2) == 28);
ok("D3", days_in_month(2024, 1) == 31 and days_in_month(2024, 4) == 30);
var derr = false;
try { days_in_month(2024, 13); } catch (e) { derr = true; }
ok("D4", derr);

// --- names --------------------------------------------------------------
ok("M1", month_name(1) == "January" and month_name(12) == "December");
ok("W1", weekday_name(0) == "Sunday" and weekday_name(6) == "Saturday");
var merr = false;
try { month_name(13); } catch (e) { merr = true; }
ok("M2", merr);

// --- unix <-> iso -------------------------------------------------------
ok("U1", str_starts_with(unix_to_iso(0), "1970-01-01"));
ok("U2", iso_to_unix("1970-01-01T00:00:00Z") == 0);
ok("U3", iso_to_unix(unix_to_iso(1700000000)) == 1700000000);   // round-trip
var uerr = false;
try { iso_to_unix("not a date"); } catch (e) { uerr = true; }
ok("U4", uerr);

print("=== done ===");
