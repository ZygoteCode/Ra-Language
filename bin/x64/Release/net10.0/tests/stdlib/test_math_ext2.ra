import std.prelude.*;
// stdlib/math_ext2 — shaping, integer division, combinatorics, extra
// transcendentals added to std.prelude.math.

fn ok(id, cond) {
    if cond { print("[" + id + "] OK"); } else { print("[" + id + "] FAIL"); }
}
fn near(a, b) { ret abs(a - b) < 0.0001; }

print("=== stdlib/math_ext2 ===");

// --- shaping -------------------------------------------------------------
ok("SS1", smoothstep(0, 10, 5) == 0.5);
ok("SS2", smoothstep(0, 10, 0 - 5) == 0);
ok("SS3", smoothstep(0, 10, 15) == 1);
ok("US1", unit_step(5, 3) == 0 and unit_step(5, 7) == 1);
ok("WR1", wrap(13, 0, 10) == 3);
ok("WR2", wrap(0 - 1, 0, 10) == 9);

// --- integer division ----------------------------------------------------
ok("CD1", ceil_div(7, 2) == 4);
ok("CD2", ceil_div(0 - 7, 2) == (0 - 3));
ok("FD1", floor_div(7, 2) == 3);
ok("FD2", floor_div(0 - 7, 2) == (0 - 4));
var dm = divmod(0 - 7, 3);
ok("DM1", tuple_at(dm, 0) == (0 - 3) and tuple_at(dm, 1) == 2);
var cderr = false;
try { ceil_div(1, 0); } catch (e) { cderr = true; }
ok("CD3", cderr);

// --- primality / combinatorics ------------------------------------------
ok("PR1", is_prime(2) and is_prime(17) and is_prime(97));
ok("PR2", is_prime(1) == false and is_prime(18) == false and is_prime(0) == false);
ok("CB1", combinations(5, 2) == 10);
ok("CB2", combinations(52, 5) == 2598960);
ok("CB3", combinations(10, 0) == 1 and combinations(4, 5) == 0);
ok("PM1", permutations(5, 2) == 20 and permutations(5, 0) == 1);
ok("FB1", fibonacci(0) == 0 and fibonacci(1) == 1);
ok("FB2", fibonacci(10) == 55 and fibonacci(20) == 6765);

// --- transcendentals -----------------------------------------------------
ok("SG1", sigmoid(0) == 0.5);
ok("LB1", near(log_base(8, 2), 3));
ok("LB2", near(log_base(1000, 10), 3));
ok("NR1", near(nth_root(27, 3), 3));
ok("MP1", midpoint(0, 10) == 5);
ok("H3", hypot3(2, 3, 6) == 7);
ok("HY1", near(asinh(0), 0) and near(atanh(0), 0) and near(acosh(1), 0));
ok("EX1", near(expm1(0), 0) and near(log1p(0), 0));

print("=== done ===");
