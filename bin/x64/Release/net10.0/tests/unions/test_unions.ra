// ============================================================
// Ra Language — Union Types & `is`-Test / Narrowing Test Suite
// ============================================================
//
// Covers, in order:
//   U1   declaration + assignment with anonymous unions
//   U2   `is T` / `is not T` runtime tests
//   U3   narrowing inside if/else/match
//   U4   match type-patterns (`case is T -> …` and `case is T as v -> …`)
//   U5   union members on function signatures (params + return type)
//   U6   nullable shortcut (`T | null`)
//   U7   union normalisation (flatten, dedup, any-absorbs)
//   U8   union inside containers (list, tuple)
//   U9   composed boolean guards built from `is`-tests
//   U10  pattern-bound type pattern preserves narrowing into the arm body
//
// Each test prints `[Un] OK` on success. Final line confirms the suite.

print("=== Union Types regression suite ===");

// ----------------------------------------------------------------
// U1 — declaration + assignment
// ----------------------------------------------------------------
fn u1() {
    let a: int | string = 5;
    let b: int | string = "hi";
    let c: int | string | bool = true;
    if a is int and b is string and c is bool { print("[U1] OK"); }
    else { print("[U1] FAIL"); }
}
u1();

// ----------------------------------------------------------------
// U2 — `is T` / `is not T`
// ----------------------------------------------------------------
fn u2() {
    let a = 5;
    let s = "hi";
    let ok = (a is int) and (s is string) and (a is not string) and (s is not int);
    if ok { print("[U2] OK"); } else { print("[U2] FAIL"); }
}
u2();

// ----------------------------------------------------------------
// U3 — narrowing in if/else (verified by runtime behaviour)
// ----------------------------------------------------------------
fn describe(v: int | string | bool): string {
    if v is int { ret "int"; }
    elif v is string { ret "string"; }
    else { ret "bool"; }
}
fn u3() {
    if describe(7) == "int" and describe("x") == "string" and describe(true) == "bool" {
        print("[U3] OK");
    } else { print("[U3] FAIL"); }
}
u3();

// ----------------------------------------------------------------
// U4 — match type-patterns
// ----------------------------------------------------------------
fn describe_match(v: int | string | bool): string {
    ret match v {
        case is int -> "int"
        case is string -> "string"
        case is bool -> "bool"
    };
}
fn u4() {
    if describe_match(7) == "int" and describe_match("x") == "string" and describe_match(false) == "bool" {
        print("[U4] OK");
    } else { print("[U4] FAIL"); }
}
u4();

// ----------------------------------------------------------------
// U5 — union on signatures + multiple call shapes
// ----------------------------------------------------------------
fn pick(x: int | string): int | string {
    ret x;
}
fn u5() {
    let a = pick(1);
    let b = pick("two");
    if (a is int) and (b is string) { print("[U5] OK"); }
    else { print("[U5] FAIL"); }
}
u5();

// ----------------------------------------------------------------
// U6 — nullable shortcut
// ----------------------------------------------------------------
fn find_name(id: int): string | null {
    if id == 0 { ret null; }
    ret "Alice";
}
fn u6() {
    let none = find_name(0);
    let some = find_name(1);
    if (none is null) and (some is string) and (none is not string) {
        print("[U6] OK");
    } else { print("[U6] FAIL"); }
}
u6();

// ----------------------------------------------------------------
// U7 — normalisation (set equality, flatten, dedup, any absorbs)
//
// Indirect verification — we cannot inspect TypeDescriptor objects
// from Ra source, but we can prove behavioural equivalence by
// feeding the same value through unions written in different shapes.
// ----------------------------------------------------------------
fn first_int(x: int | string): int {
    if x is int { ret x as int; }
    ret -1;
}
fn first_int_reordered(x: string | int): int {
    if x is int { ret x as int; }
    ret -1;
}
fn u7() {
    if first_int(42) == 42 and first_int_reordered(42) == 42 and first_int("x") == -1 and first_int_reordered("x") == -1 {
        print("[U7] OK");
    } else { print("[U7] FAIL"); }
}
u7();

// ----------------------------------------------------------------
// U8 — union inside containers
// ----------------------------------------------------------------
fn u8() {
    let xs: list<int | string> = [1, "two", 3];
    var countInt = 0;
    var countStr = 0;
    for x in xs {
        if x is int { countInt = countInt + 1; }
        elif x is string { countStr = countStr + 1; }
    }
    if countInt == 2 and countStr == 1 { print("[U8] OK"); }
    else { print("[U8] FAIL"); }
}
u8();

// ----------------------------------------------------------------
// U9 — composed boolean guards
// ----------------------------------------------------------------
fn u9() {
    let v: int | string | null = "hi";
    let composedOk = (v is not null) and ((v is int) or (v is string));
    if composedOk { print("[U9] OK"); } else { print("[U9] FAIL"); }
}
u9();

// ----------------------------------------------------------------
// U10 — match binder carries narrowed type into arm body
// ----------------------------------------------------------------
fn double_or_len(v: int | string): int {
    ret match v {
        case is int as n -> n * 2
        case is string as s -> len(s)
    };
}
fn u10() {
    if double_or_len(7) == 14 and double_or_len("hello") == 5 {
        print("[U10] OK");
    } else { print("[U10] FAIL"); }
}
u10();

print("=== ALL UNION TESTS DONE ===");
