import std.prelude.*;
// Ra Language — typed string formatting regression suite.
//
// Each case prints "[<id>] OK" on success or "[<id>] FAIL: <details>".
// Covers:
//   F1   :.Nf floating-point precision
//   F2   :#x / :#X hex with/without prefix
//   F3   :#b binary with prefix
//   F4   :#o octal with prefix
//   F5   :.N% percent
//   F6   :.N general precision (no type char)
//   F7   :e / :E scientific
//   F8   :d decimal on integers
//   F9   nested ternary inside interpolation does NOT swallow ':' as a spec
//   F10  multiple interpolations with different specs in the same literal
//   F11  bool with a numeric spec is rejected at runtime
//   F12  string with a numeric spec is rejected
//   F13  format spec on negative number
//   F14  uppercase format (X vs x)
//   F15  empty format spec falls back to default

print("=== Ra Format Specifier Tests ===");

// -- F1: float precision -----------------------------------------------------
let pi = 3.14159;
let f1 = $"v=${pi:.2f}";
if f1 == "v=3.14" { print("[F1] OK"); } else { print("[F1] FAIL " + f1); }

// -- F2: hex with and without prefix -----------------------------------------
let n = 255;
let f2a = $"${n:x}";
let f2b = $"${n:X}";
let f2c = $"${n:#x}";
let f2d = $"${n:#X}";
if f2a == "ff" and f2b == "FF" and f2c == "0xff" and f2d == "0XFF" {
    print("[F2] OK");
} else {
    print("[F2] FAIL a=" + f2a + " b=" + f2b + " c=" + f2c + " d=" + f2d);
}

// -- F3: binary --------------------------------------------------------------
let ten = 10;
let f3 = $"${ten:#b}";
if f3 == "0b1010" { print("[F3] OK"); } else { print("[F3] FAIL " + f3); }

// -- F4: octal ---------------------------------------------------------------
let eight = 8;
let f4 = $"${eight:#o}";
if f4 == "0o10" { print("[F4] OK"); } else { print("[F4] FAIL " + f4); }

// -- F5: percent -------------------------------------------------------------
let ratio = 0.875;
let f5 = $"${ratio:.1%}";
if f5 == "87.5%" { print("[F5] OK"); } else { print("[F5] FAIL " + f5); }

// -- F6: precision-only on float --------------------------------------------
let v6 = 1.23456789;
let f6 = $"${v6:.3}";
if f6 == "1.23" { print("[F6] OK"); } else { print("[F6] FAIL " + f6); }

// -- F7: scientific notation -------------------------------------------------
let v7 = 12345.0;
let f7 = $"${v7:.2e}";
if f7 == "1.23e+004" or f7 == "1.23e+04" {
    print("[F7] OK");
} else {
    print("[F7] FAIL " + f7);
}

// -- F8: decimal on integer --------------------------------------------------
let v8 = 42;
let f8 = $"${v8:d}";
if f8 == "42" { print("[F8] OK"); } else { print("[F8] FAIL " + f8); }

// -- F9: ternary inside interpolation is unambiguous -------------------------
// `${flag ? a : b}` must NOT be parsed as a format spec — there is no valid
// spec text after the ':' so the lexer leaves the whole body as expression.
let f9_flag = 1;
let f9 = $"${f9_flag == 1 ? 99 : 0}";
if f9 == "99" { print("[F9] OK"); } else { print("[F9] FAIL " + f9); }

// -- F10: multi-segment literal ----------------------------------------------
let v10 = 7;
let v10b = 0.5;
let f10 = $"int=${v10:d}, hex=${v10:#x}, frac=${v10b:.3f}";
if f10 == "int=7, hex=0x7, frac=0.500" { print("[F10] OK"); } else { print("[F10] FAIL " + f10); }

// -- F11: bool with numeric spec is rejected ---------------------------------
let b11 = true;
try {
    let _f11 = $"${b11:.2f}";
    print("[F11] FAIL: bool accepted a float spec");
} catch (e) {
    print("[F11] OK");
}

// -- F12: string with numeric spec is rejected -------------------------------
let s12 = "hi";
try {
    let _f12 = $"${s12:.2f}";
    print("[F12] FAIL: string accepted a float spec");
} catch (e) {
    print("[F12] OK");
}

// -- F13: negative number with float spec ------------------------------------
let v13 = -1.5;
let f13 = $"${v13:.2f}";
if f13 == "-1.50" { print("[F13] OK"); } else { print("[F13] FAIL " + f13); }

// -- F14: uppercase hex ------------------------------------------------------
let v14 = 2748;
let f14 = $"${v14:#X}";
if f14 == "0XABC" { print("[F14] OK"); } else { print("[F14] FAIL " + f14); }

// -- F15: bare expression keeps the default formatting -----------------------
let v15 = 3.5;
let f15 = $"${v15}";
if f15 == "3.5" { print("[F15] OK"); } else { print("[F15] FAIL " + f15); }

print("=== Done ===");
