import std.prelude.*;
// Ra Language — lexical scope regression suite.
//
// Each case prints "[<id>] OK" on success or "[<id>] FAIL: <details>" on failure.
// The cases cover:
//   1.  inner declaration invisible outside its block
//   2.  shadowing across nested blocks
//   3.  outer mutation from inside an inner block
//   4.  while-loop reads outer variable updated by the body
//   5.  same iter-variable name in sibling for loops (no cross-talk)
//   6.  assignment to undefined variable -> runtime error
//   7.  access after exiting the declaring block -> runtime error
//   8.  for-loop iter variable does not leak past loop exit
//   9.  shadowing inside a while-loop body, outer untouched
//   10. for-loop body shadow declared anew every iteration
//   11. if/else branch scopes isolated; outer mutation still propagates
//   12. do-while body locals do not leak, outer mutations propagate
//   13. foreach iter variable shadows outer of same name; outer preserved
//   14. function-local mutation does NOT bleed into caller's same-named var
//   15. nested blocks: 3-level shadow chain unwinds correctly

print("=== Ra Scope Tests ===");

// --------------------------------------------------------------------------
// 1. Inner declaration invisible outside its block
// --------------------------------------------------------------------------
{
    var inner_only = 7;
}
try {
    var probe = inner_only;
    print("[1] FAIL: inner_only leaked, probe=" + (probe as string));
} catch (e) {
    print("[1] OK");
}

// --------------------------------------------------------------------------
// 2. Shadowing across nested blocks
// --------------------------------------------------------------------------
var s2 = "outer";
{
    var s2 = "inner";
    if s2 != "inner" { print("[2a] FAIL inner=" + s2); } else { print("[2a] OK"); }
}
if s2 != "outer" { print("[2b] FAIL outer was clobbered: " + s2); } else { print("[2b] OK"); }

// --------------------------------------------------------------------------
// 3. Outer mutation from inside an inner block
// --------------------------------------------------------------------------
var counter3 = 0;
{
    counter3 = counter3 + 1;
    counter3 = counter3 + 1;
}
if counter3 != 2 { print("[3] FAIL counter3=" + (counter3 as string)); } else { print("[3] OK"); }

// --------------------------------------------------------------------------
// 4. While reads outer var updated by the body
// --------------------------------------------------------------------------
var n4 = 0;
var sum4 = 0;
while n4 < 5 {
    sum4 = sum4 + n4;
    n4 = n4 + 1;
}
if n4 == 5 and sum4 == 10 { print("[4] OK"); } else { print("[4] FAIL n4=" + (n4 as string) + " sum4=" + (sum4 as string)); }

// --------------------------------------------------------------------------
// 5. Same iter name in two sibling for loops — no cross-talk
// --------------------------------------------------------------------------
var totalA = 0;
for i = 0 to 3 { totalA = totalA + i; }
var totalB = 0;
for i = 0 to 4 { totalB = totalB + i; }
if totalA == 3 and totalB == 6 { print("[5] OK"); } else { print("[5] FAIL A=" + (totalA as string) + " B=" + (totalB as string)); }

// --------------------------------------------------------------------------
// 6. Assignment to undefined variable -> runtime error
// --------------------------------------------------------------------------
try {
    not_declared = 7;
    print("[6] FAIL: assignment to undefined succeeded");
} catch (e) {
    print("[6] OK");
}

// --------------------------------------------------------------------------
// 7. Access after exiting the declaring block -> runtime error
// --------------------------------------------------------------------------
{
    var ephemeral = 42;
    if ephemeral != 42 { print("[7a] FAIL"); }
}
try {
    var probe7 = ephemeral;
    print("[7b] FAIL: ephemeral survived its block");
} catch (e) {
    print("[7] OK");
}

// --------------------------------------------------------------------------
// 8. For-loop iter variable does not leak past loop exit
// --------------------------------------------------------------------------
for j8 = 0 to 3 { pass; }
try {
    var v8 = j8;
    print("[8] FAIL: j8 leaked, v8=" + (v8 as string));
} catch (e) {
    print("[8] OK");
}

// --------------------------------------------------------------------------
// 9. Shadow inside while body; outer untouched after the loop
// --------------------------------------------------------------------------
var x9 = 100;
var k9 = 0;
while k9 < 3 {
    var x9 = k9 * 10;
    k9 = k9 + 1;
}
if x9 == 100 { print("[9] OK"); } else { print("[9] FAIL x9=" + (x9 as string)); }

// --------------------------------------------------------------------------
// 10. For-loop body shadow declared anew every iteration (no "already defined")
// --------------------------------------------------------------------------
var collected10 = 0;
for i10 = 0 to 4 {
    var local = i10 * i10;
    collected10 = collected10 + local;
}
if collected10 == 14 { print("[10] OK"); } else { print("[10] FAIL collected=" + (collected10 as string)); }

// --------------------------------------------------------------------------
// 11. If/else branch scopes are isolated; outer mutation in branch propagates
// --------------------------------------------------------------------------
var outer11 = 0;
if true {
    var branch_local = 5;
    outer11 = branch_local * 2;
}
try {
    var probe11 = branch_local;
    print("[11a] FAIL: branch_local leaked");
} catch (e) {
    if outer11 == 10 { print("[11] OK"); } else { print("[11] FAIL outer11=" + (outer11 as string)); }
}

// --------------------------------------------------------------------------
// 12. do-while body locals do not leak; outer mutations propagate
// --------------------------------------------------------------------------
var dw = 0;
do {
    var dw_local = 1;
    dw = dw + dw_local;
} while dw < 3;
try {
    var p = dw_local;
    print("[12a] FAIL: dw_local leaked");
} catch (e) {
    if dw == 3 { print("[12] OK"); } else { print("[12] FAIL dw=" + (dw as string)); }
}

// --------------------------------------------------------------------------
// 13. foreach iter shadows outer same-name; outer preserved on exit
// --------------------------------------------------------------------------
var item = "outer_item";
var collected13 = "";
for item in [10, 20, 30] {
    collected13 = collected13 + (item as string) + ",";
}
if item == "outer_item" and collected13 == "10,20,30," { print("[13] OK"); } else { print("[13] FAIL item=" + (item as string) + " collected=" + collected13); }

// --------------------------------------------------------------------------
// 14. Function-local var does NOT leak into caller's same-named var
// --------------------------------------------------------------------------
var n14 = 999;
fn touch_local() {
    var n14 = 1;
    n14 = n14 + 1;
}
touch_local();
if n14 == 999 { print("[14] OK"); } else { print("[14] FAIL n14=" + (n14 as string)); }

// --------------------------------------------------------------------------
// 15. 3-level shadow chain unwinds correctly
// --------------------------------------------------------------------------
var z = "L0";
{
    var z = "L1";
    {
        var z = "L2";
        {
            var z = "L3";
            if z != "L3" { print("[15a] FAIL z=" + z); }
        }
        if z != "L2" { print("[15b] FAIL z=" + z); }
    }
    if z != "L1" { print("[15c] FAIL z=" + z); }
}
if z != "L0" { print("[15d] FAIL z=" + z); } else { print("[15] OK"); }

// --------------------------------------------------------------------------
// 16. Mutations to outer var inside loop body persist after loop
// --------------------------------------------------------------------------
var acc = 0;
for x = 1 to 5 {
    acc = acc + x;
}
if acc == 10 { print("[16] OK"); } else { print("[16] FAIL acc=" + (acc as string)); }

// --------------------------------------------------------------------------
// 17. const cannot be reassigned (sanity check that flags survive scope-exit)
// --------------------------------------------------------------------------
const k17 = 5;
{
    try {
        k17 = 6;
        print("[17] FAIL: const reassigned in inner block");
    } catch (e) {
        print("[17] OK");
    }
}

// --------------------------------------------------------------------------
// 18. Inner shadow of a const is OK; outer const stays const after scope exit
// --------------------------------------------------------------------------
const c18 = 1;
{
    var c18 = 99;
    c18 = c18 + 1;
}
try {
    c18 = 2;
    print("[18] FAIL: outer c18 lost const-ness");
} catch (e) {
    if c18 == 1 { print("[18] OK"); } else { print("[18] FAIL c18=" + (c18 as string)); }
}

print("=== End Ra Scope Tests ===");
