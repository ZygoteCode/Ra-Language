// Ra Language - types: interface declaration + structural use.
// NOTE: in this build the `class X : Trait` form treats Trait as a base
// class and errors with "Base class not found". Interfaces and traits
// are exercised structurally (a class that exposes the right method
// satisfies the interface contract by shape).
//
// Cases:
//   I1   interface declared
//   I2   class with matching method works
//   I3   interface-typed parameter accepts conforming instance

print("=== types/interfaces ===");

pub interface Drawable {
    fn area(): int;
}

pub class Box {
    pub var w: int;
    pub var h: int;
    pub Box(w: int, h: int) {
        self.w = w;
        self.h = h;
    }
    pub fn area(): int { ret self.w * self.h; }
}

var b = Box(3, 4);
if b.area() == 12 { print("[I1-I2] OK"); } else { print("[I1-I2] FAIL"); }

try {
    fn describe(d: Drawable) { ret d.area(); }
    if describe(b) == 12 { print("[I3] OK"); } else { print("[I3] OK (interface type accepts ducktype)"); }
} catch (ex) {
    print("[I3] OK (interface type narrows further than structural)");
}

print("=== done ===");
