import std.prelude.*;
// Ra Language - types: records (value flavor by default, reference
// flavor via `record class`). Covers definition, instantiation,
// structural equality / hashing-via-equality, with-expressions,
// deconstruction-via-fields, immutability of primary fields,
// methods + operator overloads, generics, defaults, controlled
// inheritance, @derive opt-outs, deconstruct(), pattern match,
// and a handful of negative paths.
//
// Cases:
//   R1   primary-field constructor + field reads
//   R2   record-style auto to_string format
//   R3   structural equality   ==   (positive case)
//   R4   structural inequality ==   (different field value)
//   R5   structural inequality ==   (different declared type)
//   R6   with-expression — single override
//   R7   with-expression — multiple overrides; receiver unchanged
//   R8   with-expression — produces a structurally-equal sibling
//   R9   with-expression — unknown field raises a precise error
//   R10  primary fields are immutable by default
//   R11  `mut` primary field on a `record class` allows in-place
//        reassignment (value records use `with` instead, since
//        in-place mutation of a value-semantic type would only
//        write to a transient copy of the receiver)
//   R12  body method using self
//   R13  body operator overload — addition
//   R14  generic record
//   R15  default-value primary field
//   R16  nested records: equality drills down into inner records
//   R17  record + list field: structural equality element-wise
//   R18  record class: reference flavor, structural equality still works
//   R19  passing a record into a function preserves identity-by-value
//   R20  user-defined to_string overrides the auto format
//   R21  built-in deconstruct() returns tuple of primary fields
//   R22  pattern match: `case Point(x, y) -> ...` binds positionally
//   R23  pattern match: arity mismatch raises a precise diagnostic
//   R24  pattern match: cross-type record never matches
//   R25  @derive(equals=false) disables auto structural equality
//        (falls back to reference identity)
//   R26  @derive(to_string=false) disables auto record format
//        (falls back to non-leaky '<Name>' shape)
//   R27  @derive(equals=false, to_string=false) — both flags
//   R28  abstract record class: abstract base cannot be instantiated
//   R29  record class inheritance: child observes inherited fields
//        in primary-field order (deconstruct merged shape)
//   R30  inherited records compare equal only with same concrete
//        Definition (no EqualityContract slip)
//   R31  inheritance refuses to redeclare inherited primary fields
//   R32  value records cannot inherit (always sealed)

print("=== types/records ===");

record Point(x: int, y: int)

var p = Point(3, 4);
if p.x == 3 and p.y == 4 { print("[R1] OK"); } else { print("[R1] FAIL"); }

if (p as string) == "Point(x=3, y=4)" { print("[R2] OK"); } else { print("[R2] FAIL got: " + (p as string)); }

var p1 = Point(1, 2);
var p2 = Point(1, 2);
var p3 = Point(1, 3);

if p1 == p2 { print("[R3] OK"); } else { print("[R3] FAIL"); }
if p1 != p3 { print("[R4] OK"); } else { print("[R4] FAIL"); }

record Pair(x: int, y: int)
var pair = Pair(1, 2);
if pair != p1 { print("[R5] OK"); } else { print("[R5] FAIL (cross-type equality)"); }

var p4 = p1 with { x: 10 };
if p4.x == 10 and p4.y == 2 { print("[R6] OK"); } else { print("[R6] FAIL"); }

var p5 = p1 with { x: 99, y: 88 };
if p5.x == 99 and p5.y == 88 and p1.x == 1 and p1.y == 2 { print("[R7] OK"); } else { print("[R7] FAIL"); }

var p6 = p1 with { x: 1, y: 2 };
if p6 == p1 { print("[R8] OK"); } else { print("[R8] FAIL"); }

try {
    var bad = p1 with { z: 5 };
    print("[R9] FAIL (no error)");
} catch (ex) {
    print("[R9] OK");
}

try {
    p1.x = 99;
    print("[R10] FAIL (no error)");
} catch (ex) {
    print("[R10] OK");
}

record class Counter(mut n: int)
var c = Counter(0);
c.n = 5;
if c.n == 5 { print("[R11] OK"); } else { print("[R11] FAIL"); }

record Vec3(x: float, y: float, z: float) {
    pub fn magnitude_sq(): float {
        ret (self.x * self.x + self.y * self.y + self.z * self.z) as float;
    }
}
var v = Vec3(1.0, 2.0, 2.0);
if v.magnitude_sq() == 9.0 { print("[R12] OK"); } else { print("[R12] FAIL"); }

record Money(amount: int, currency: string) {
    operator +(other: Money): Money {
        ret Money(self.amount + other.amount, self.currency);
    }
}
var m1 = Money(100, "EUR");
var m2 = Money(50, "EUR");
var m3 = m1 + m2;
if m3.amount == 150 and m3.currency == "EUR" { print("[R13] OK"); } else { print("[R13] FAIL"); }

record Box<T>(value: T)
var bi = Box(7);
var bs = Box("hi");
if bi.value == 7 and bs.value == "hi" { print("[R14] OK"); } else { print("[R14] FAIL"); }

record Config(retries: int = 3, label: string = "default")
var cfg = Config();
if cfg.retries == 3 and cfg.label == "default" { print("[R15] OK"); } else { print("[R15] FAIL"); }

// Children intentionally typed as `any` — Ra has no nullable shorthand,
// and we want to be able to slot `null` in for a leaf.
record Tree(value: int, left: any, right: any)
var t1 = Tree(1, Tree(2, null, null), Tree(3, null, null));
var t2 = Tree(1, Tree(2, null, null), Tree(3, null, null));
var t3 = Tree(1, Tree(99, null, null), Tree(3, null, null));
if t1 == t2 { print("[R16a] OK"); } else { print("[R16a] FAIL"); }
if t1 != t3 { print("[R16b] OK"); } else { print("[R16b] FAIL"); }

record Bundle(name: string, items: list)
var b1 = Bundle("a", [1, 2, 3]);
var b2 = Bundle("a", [1, 2, 3]);
if b1 == b2 { print("[R17] OK"); } else { print("[R17] FAIL"); }

record class Person(name: string, age: int)
var pa = Person("Ana", 30);
var pb = Person("Ana", 30);
if pa == pb { print("[R18] OK"); } else { print("[R18] FAIL"); }

fn double_x(pt: Point): Point { ret pt with { x: pt.x * 2 }; }
var p7 = Point(5, 6);
var p8 = double_x(p7);
if p7.x == 5 and p8.x == 10 and p8.y == 6 { print("[R19] OK"); } else { print("[R19] FAIL"); }

record Named(label: string) {
    pub fn to_string(): string {
        ret "<<" + self.label + ">>";
    }
}
var n = Named("hi");
if (n as string) == "<<hi>>" { print("[R20] OK"); } else { print("[R20] FAIL got: " + (n as string)); }

// R21 — deconstruct() returns a tuple of primary fields.
var dp = Point(7, 8);
var dt = dp.deconstruct();
if dt[0] == 7 and dt[1] == 8 { print("[R21] OK"); } else { print("[R21] FAIL"); }

// R22 — pattern match: positional destructure.
var pm = Point(11, 22);
var pmLabel = match pm {
    case Point(a, b) -> (a as string) + "," + (b as string)
};
if pmLabel == "11,22" { print("[R22] OK"); } else { print("[R22] FAIL " + pmLabel); }

// R23 — pattern match: arity mismatch.
try {
    var bad = match pm {
        case Point(only_one) -> "x"
    };
    print("[R23] FAIL (no error)");
} catch (ex) {
    print("[R23] OK");
}

// R24 — pattern match: cross-type record never matches.
record Pair2(x: int, y: int)
var pp = Pair2(11, 22);
var crossMatched = false;
var crossLabel = match pm {
    case Pair2(_, _) -> ("matched-Pair2")
    case _ -> ("not-Pair2")
};
if crossLabel == "not-Pair2" { print("[R24] OK"); } else { print("[R24] FAIL " + crossLabel); }

// R25 — @derive(equals=false) disables auto equality. Reference
// flavor (`record class`) lets us observe the identity fallback
// (structurally identical instances are NOT equal; an alias of
// the same instance IS).
@derive(equals=false)
record class NoEq(x: int, y: int)
var ne1 = NoEq(1, 2);
var ne2 = NoEq(1, 2);
var ne3 = ne1;
if ne1 != ne2 and ne1 == ne1 and ne1 == ne3 { print("[R25] OK"); } else { print("[R25] FAIL"); }

// R26 — @derive(to_string=false) disables auto format.
@derive(to_string=false)
record Opaque(secret: int)
var op = Opaque(42);
if (op as string) == "<Opaque>" { print("[R26] OK"); } else { print("[R26] FAIL got: " + (op as string)); }

// R27 — both flags off.
@derive(equals=false, to_string=false)
record Plain(x: int)
var pl1 = Plain(10);
var pl2 = Plain(10);
if pl1 != pl2 and (pl1 as string) == "<Plain>" { print("[R27] OK"); } else { print("[R27] FAIL"); }

// R28 — abstract record class cannot be instantiated.
abstract record class Shape(name: string)
try {
    var ax = Shape("X");
    print("[R28] FAIL (no error)");
} catch (ex) {
    print("[R28] OK");
}

// R29 — controlled inheritance: child sees inherited fields in
// primary-field order. `Circle(radius: float) : Shape("Circle")`
// produces a 2-field instance (name, radius) — deconstruct sees
// the merged shape.
record class Circle(radius: float) : Shape("Circle")
var ci = Circle("Circle", 2.0);
var ctup = ci.deconstruct();
if ctup[0] == "Circle" and ctup[1] == 2.0 { print("[R29] OK"); } else { print("[R29] FAIL"); }

// R30 — equality remains type-restricted under inheritance: two
// child instances with identical structural shape compare equal,
// but a hypothetical sibling record with the same fields would
// not (different Definition reference).
var ci2 = Circle("Circle", 2.0);
record class Disc(radius: float) : Shape("Disc")
var di = Disc("Disc", 2.0);
if ci == ci2 and (ci as string) != (di as string) { print("[R30] OK"); } else { print("[R30] FAIL"); }

// R31 — child cannot redeclare inherited primary fields.
try {
    record class Bad(name: string, radius: float) : Shape("Bad")
    var bad2 = Bad("Bad", 0.0);
    print("[R31] FAIL (no error)");
} catch (ex) {
    print("[R31] OK");
}

// R32 — value records reject inheritance. `record X(...) : Y(...)`
// is a definition-time error since value records are always sealed.
// (Compile-time error path; we wrap the use site in try to surface.)
try {
    record ValBase(x: int)
    record ValDerived(y: int) : ValBase(0)
    var vd = ValDerived(0, 0);
    print("[R32] FAIL (no error)");
} catch (ex) {
    print("[R32] OK");
}

print("=== done ===");
