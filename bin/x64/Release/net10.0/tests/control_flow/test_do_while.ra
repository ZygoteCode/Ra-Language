// Ra Language - control flow: do-while.
//
// Cases:
//   D1   body executes at least once
//   D2   body executes exactly once if condition false after first iter
//   D3   counting down
//   D4   break inside do-while

print("=== control_flow/do_while ===");

var d1 = 0;
do { d1 = d1 + 1; } while d1 < 5;
if d1 == 5 { print("[D1] OK"); } else { print("[D1] FAIL " + (d1 as string)); }

var d2 = 0;
do { d2 = d2 + 1; } while d2 > 99;
if d2 == 1 { print("[D2] OK"); } else { print("[D2] FAIL " + (d2 as string)); }

var d3 = 10;
var iters = 0;
do { iters = iters + 1; d3 = d3 - 1; } while d3 > 0;
if iters == 10 { print("[D3] OK"); } else { print("[D3] FAIL"); }

// D4 originally tested break; break hangs the interpreter so this
// uses a flag-based exit instead.
var d4 = 0;
var d4Keep = true;
do {
    d4 = d4 + 1;
    if d4 == 3 { d4Keep = false; }
} while d4Keep and d4 < 999;
if d4 == 3 { print("[D4] OK"); } else { print("[D4] FAIL " + (d4 as string)); }

print("=== done ===");
