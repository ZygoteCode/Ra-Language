import std.prelude.*;
// Ra Language - control flow: for.
//
// Cases:
//   F1   for i = 0 to N
//   F2   for i = 0 to N step S
//   F3   for x in list
//   F4   for x in range exclusive
//   F5   for x in range inclusive
//   F6   for x in map keys (string keys)
//   F7   break in for
//   F8   continue in for
//   F9   nested for loops

print("=== control_flow/for ===");

var f1 = 0;
for i = 0 to 5 { f1 = f1 + 1; }
if f1 == 5 { print("[F1] OK"); } else { print("[F1] FAIL " + (f1 as string)); }

var f2 = 0;
for i = 0 to 10 step 2 { f2 = f2 + 1; }
if f2 == 5 { print("[F2] OK"); } else { print("[F2] FAIL " + (f2 as string)); }

var f3 = 0;
for v in [10, 20, 30] { f3 = f3 + v; }
if f3 == 60 { print("[F3] OK"); } else { print("[F3] FAIL"); }

var f4 = 0;
for v in 1..5 { f4 = f4 + v; }
if f4 == 10 { print("[F4] OK"); } else { print("[F4] FAIL " + (f4 as string)); }

var f5 = 0;
for v in 1..=5 { f5 = f5 + v; }
if f5 == 15 { print("[F5] OK"); } else { print("[F5] FAIL"); }

try {
    var f6 = 0;
    for k in {"a": 1, "b": 2} { f6 = f6 + 1; }
    if f6 == 2 { print("[F6] OK"); } else { print("[F6] FAIL " + (f6 as string)); }
} catch (ex) { print("[F6] FAIL: " + ex); }

// F7 (break in for) is regression-only; see tests/regressions/break_hangs_loops.ra.
// Stand-in: use a mutable flag to mirror early-exit behaviour.
var f7 = 0;
var f7Keep = true;
for v in [1, 2, 3, 4, 5] {
    if v == 3 { f7Keep = false; }
    if f7Keep { f7 = f7 + 1; }
}
if f7 == 2 { print("[F7] OK"); } else { print("[F7] FAIL " + (f7 as string)); }

var f8 = 0;
for v in [1, 2, 3, 4, 5] {
    if v % 2 == 0 { continue; }
    f8 = f8 + v;
}
if f8 == 9 { print("[F8] OK"); } else { print("[F8] FAIL " + (f8 as string)); }

var f9 = 0;
for i = 0 to 3 {
    for j = 0 to 4 { f9 = f9 + 1; }
}
if f9 == 12 { print("[F9] OK"); } else { print("[F9] FAIL " + (f9 as string)); }

print("=== done ===");
