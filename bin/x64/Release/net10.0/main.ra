fn oopify(prefix) => prefix + "oop"

fn join(elements, separator) {
	var result = ""
	var length = len(elements)

	for i = 0 to length {
		var result = result + elements/i
		if i != length - 1: var result = result + separator
	}

	ret result
}

fn map(elements, func) {
	var new_elements = []

	for i = 0 to len(elements) {
        var new_elements = new_elements + func(elements/i)
	}

	{
		var i = 7
		var i = i + 7
	}

	ret new_elements
}


print("Greetings universe!")

for i = 0 to 5: print(join(map(["l", "sp"], oopify), ", "))
var a = 5

if a == 5 {
	print("Yes!")
} elif a == 7 {
	print("Far away")
} else {
	print("Oh yeah")
}

var x = 7

while x > 0 {
	var x = x - 1
	print(x)
}

var x = 6;

if x == 7 {
	pass
} else {
	print("ciao")
}


{
	var y = 5 + 5
	print(y)

	{
		var z = 10 + 10
		print(z)
	}

	print("continue other scope")
}

print("finished scope")