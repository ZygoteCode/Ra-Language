var day = 3;

switch (day) {
    case 1:
        print("Monday");
        break;
    case 2:
        print("Tuesday");
        break;
    case 3:
        print("Wednesday");
        break;
    default:
        print("Another day");
}

switch (day) {
    case 1 -> print("Monday");
    case 2 -> print("Tuesday");
    case 3 -> {
        print("Wednesday");
        print("Mid week!");
    }
    default -> print("Another day!");
}

day = 3;

var dayName = switch (day) {
    case 1 -> "Monday";
    case 2 -> "Tuesday";
    case 3 -> {
        print("Wednesday!");
        yield "Wednesday";
    }
    case 4, 5 -> "Almost weekend";
    default -> "Weekend";
};

print(dayName);

var n = 2;
switch (n) {
    case 1:
        print("One");
    case 2:
        print("Two");
        break;
    case 3:
        print("Three");
}

var x = 99;

while true {
    x--;

    if (x == 1) {
        break;
    } else {
        continue;
    }
}