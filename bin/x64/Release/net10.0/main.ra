if ("e" in "hello") {
    print("Hello, world!");
}

if (1 in (1, 3)) {
    print("is in tuple");
}

if (5 in "5 + 5") {
    print("5 is in 5 + 5");
}

if (3 in 1..5) {
    print("There is the number 3 from 1 to 5");
    print($"Interpolated result: ${3 + 8}");
}

for x in 0..=20:2 {
    print(x);
}

if (11 === 3 + 8) {
    print("eh sì");
}

if (("key", "value") in {"key": "value", "test": 5.5}) {
    print("works!!!");
}

for x in {"a": "b", "c": "d", "e": "f"} {
    print(x)
    print($"Key: ${x[0]}")
}

for x in (1, 2, 3, 4, 5, 6, 7) {
    print(x);
}