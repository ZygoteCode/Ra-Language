pub class Person {
   pub var name: string;
   pub var surname: string;

   pub Person(name: string, surname: string) {
       self.name = name;
       self.surname = surname;
   }

   pub fn get_name() {
       ret self.name;
   }

   pub fn get_surname() {
       ret self.surname;
   }
}

pub class Father : Person {
   pub Father(name: string, surname: string) {
       super(name, surname);
       print(surname);
   }

   pub override fn get_name() {
       ret super.get_name();
   }

   pub override fn get_surname() {
       ret "not working";
   }
}

var my_father = Father("Alessandro", "Favata");
print(my_father.get_name());

var my_person = Person("Gabriele", "Favata");
print(my_person.get_name());

print(my_father.get_surname());
print(my_person.get_surname());