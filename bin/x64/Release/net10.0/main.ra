enum Mode { Off, On = 5, Auto }

pub struct Person {
   pub var name: string;
   pub var surname: string;
   pub var age: string;
   pub var mode: Mode;

   pub Person(name: string, surname: string) {
       self.name = name;
       self.surname = surname;
       self.age = 0;
       self.mode = Mode.Auto;
   }

   pub Person(name: string, surname: string, age: int) {
       self.name = name;
       self.surname = surname;
       self.age = age;
   }

   pub fn get_name() {
       ret self.name;
   }
   
   pub fn set_name(name: string) {
       self.name = name;
   }

   pub fn get_mode() {
        ret self.mode;
   }
}

var my_person = Person("Gabriele", "Favaro");
print(my_person.get_name());
my_person.set_name("Alessandro");
print(my_person.get_name());
print(my_person.get_mode());

var a: Mode = Mode.On;
print(a);          // Mode.On
print(a as int);   // 5

print(typeof(Mode));
print(typeof(a));
print(typeof(Person));
print(typeof(my_person));