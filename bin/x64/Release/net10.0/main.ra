pub class Person {
    pub var name: string;
    pub var surname: string;

    pub Person(name: string, surname: string) {
        self.name = name;
        self.surname = surname;
    }

    pub fn set_name(name: string) {
        self.name = name;
    }

    pub fn get_name(): string {
        ret self.name;
    }

    pub fn set_surname(surname: string) {
        self.surname = surname;
    }

    pub fn get_surname(): string {
        ret self.surname;
    }
}

