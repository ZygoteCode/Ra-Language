print("=== IMPORT DEBUG TEST ===");

fn test_import() {
    print("Test started...");
    
    import 'other.ra' as module_alias;
    
    print("Import completed!");
    print("Calling Other.say_hello()...");
    
    module_alias.Other.say_hello();
    var x: int = 5;
    print(x.sum(3));    
    
    print("Test completed!");
}

fn test_import1() {
    print("Test started...");
    
    import { Other, test_function } from 'other.ra';
    
    print("Import completed!");
    print("Calling Other.say_hello()...");
    
    Other.say_hello();
    var x: int = 5;
    print(x.sum(3));    
    test_function();
    
    print("Test completed!");
}

test_import();
test_import1();