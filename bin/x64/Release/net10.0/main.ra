# This is a very useful piece of software

fn oopify(prefix) -> prefix + "oop"

fn join(elements, separator)
	var result = ""
	var length = len(elements)

	for i = 0 to length then
		var result = result + elements/i
		if i != length - 1 then var result = result + separator
	end

	return result
end

fn map(elements, func)
	var new_elements = []

	for i = 0 to len(elements) then
        var new_elements = new_elements + func(elements/i)
	end

	return new_elements
end

print("Greetings universe!")

for i = 0 to 5 then
	print(join(map(["l", "sp"], oopify), ", "))
end

var a = 5

if a == 5 then
	print("Yes!")
elif a == 7 then
	print("Far away")
else
	print("Oh yeah")
end

print('test')