// ============ Validation V2 (7 extensions) ============

fn must_fail(label: string, callback): string {
    try {
        callback();
        ret label + " UNEXPECTED OK";
    } catch (e) {
        ret label + " => caught: " + e;
    }
}

print("=== 1. @returns: validate function return value ===");
@returns(@min(0), @max(100))
fn percent(p: int): int { ret p; }
print(percent(50));
fn call_pct_over() => percent(150);
print(must_fail("@returns @max", call_pct_over));
fn call_pct_neg() => percent(-5);
print(must_fail("@returns @min", call_pct_neg));

print("=== 2. @returns on class method ===");
pub class Calc {
    @returns(@positive)
    pub fn abs_count(n: int): int { ret n; }
}
var c = Calc();
print(c.abs_count(7));
fn call_method_zero() => c.abs_count(0);
print(must_fail("@returns method @positive", call_method_zero));

print("=== 3. @all_of: chain validators (both must pass) ===");
fn middle(@all_of(@min(10), @max(20)) x: int): int { ret x; }
print(middle(15));
fn call_low() => middle(5);
print(must_fail("@all_of low", call_low));
fn call_high() => middle(25);
print(must_fail("@all_of high", call_high));

print("=== 4. @any_of: any branch matches ===");
fn pickone(@any_of(@min(100), @max(0)) v: int): int { ret v; }
print(pickone(150));    // ok via @min(100)
print(pickone(-5));     // ok via @max(0)
fn call_middle() => pickone(50);
print(must_fail("@any_of none", call_middle));

print("=== 5. @when: conditional validation ===");
fn looks_big(v): bool { ret v > 50; }
fn use_when(@when(condition = "looks_big", apply = @max(100)) v: int): int { ret v; }
print(use_when(10));    // skip @max because gate false
print(use_when(80));    // gate true, 80 <= 100 ok
fn call_too_big() => use_when(200);
print(must_fail("@when triggered max", call_too_big));

print("=== 6. @same_as: cross-field check ===");
fn signup(password: string, @same_as("password") confirm: string): string { ret password; }
print(signup("secret", "secret"));
fn call_mismatch() => signup("a", "b");
print(must_fail("@same_as mismatch", call_mismatch));

print("=== 7. @deferred: collect, drain via validate_deferred() ===");
@deferred
@target("parameter", "variable")
@validator(check = "always_fails", message = "{subject}: forced fail value={value}")
annotation HeavyCheck() {}

fn always_fails(value, ann): bool { ret false; }

fn use_deferred(@HeavyCheck v: int): int { ret v; }
print(use_deferred(42));  // immediate ok (deferred)
print(use_deferred(99));
var deferred_errs = validate_deferred();
print(deferred_errs);
print("after drain count would be 0");

print("=== 8. @coerce direct on param ===");
fn login_user(@coerce(strategy = "trim") @coerce(strategy = "lower") name: string): string { ret name; }
print(login_user("  Alice  "));

print("=== 9. @coerce on var (string->int) ===");
@coerce(strategy = "to_int")
var raw_age = "42";
print(raw_age);
print(typeof raw_age);

print("=== 10. @coerce + @min validation in chain ===");
fn safe_count(@coerce(strategy = "clamp_non_negative") @min(0) n: int): int { ret n; }
print(safe_count(5));
print(safe_count(-10));  // clamped to 0, then @min(0) passes

print("=== 11. @coerce with custom user fn ===");
fn double_it(v, ann) { ret v * 2; }
@coerce(handler = "double_it")
var scaled = 7;
print(scaled);   // 14

print("=== 12. Static analyzer catches literal violation ===");
// Define annotation then literal that violates — static pass logs warning.
// Runtime also catches; wrap in helper to keep the suite running.
fn def_bad() {
    @min(100)
    const TOO_SMALL = 5;
}
print(must_fail("@min runtime after static warn", def_bad));

print("=== ALL V2 EXTENSIONS PASSED ===");
