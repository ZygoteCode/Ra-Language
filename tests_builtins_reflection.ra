print("=== REFLECTION TESTS ===");

pub class Animal {
    pub var name: string = "?";
    pub var age: int = 0;
    pub fn speak() { ret "<silence>"; }
}

pub class Dog : Animal {
    pub var breed: string = "?";
    pub override fn speak() { ret "woof"; }
    pub fn fetch() { ret self.name + " fetches"; }
}

pub struct Point {
    pub var x: int = 0,
    pub var y: int = 0
}

enum Color { RED, GREEN, BLUE = 5 }

pub interface Named {
    fn get_name();
}

pub trait Greeter {
    fn greet() { ret "hi"; }
}

print("--- type checks on primitives ---");
print(type_of(42));
print(type_of(3.14));
print(type_of("hello"));
print(type_of(true));
print(type_of(null));
print(type_of([1, 2, 3]));
print(type_of({1, 2, 3}));
print(type_of({"a": 1}));
print(type_of((1, 2)));

print("--- kind checks ---");
print(type_kind(42));
print(type_kind("x"));
print(type_kind(null));

print("--- is_* predicates ---");
print(is_null(null));
print(is_null(0));
print(is_string("x"));
print(is_list([1]));
print(is_map({"a": 1}));
print(is_set({1, 2}));
print(is_tuple((1, 2)));
print(is_function(print));
print(is_class(Animal));
print(is_class_instance(Dog()));
print(is_struct(Point));
print(is_struct_instance(Point()));
print(is_enum(Color));
print(is_enum_value(Color.RED));
print(is_callable(print));
print(is_truthy(1));
print(is_truthy(0));

print("--- class introspection ---");
var d = Dog();
d.name = "Rex";
d.breed = "Lab";

print(class_of(d));
print(base_class(Dog));
print(super_classes(Dog));
print(fields_of(d));
print(methods_of(Dog));
print(has_method(Dog, "speak"));
print(has_method(Dog, "fetch"));
print(has_method(Dog, "nope"));
print(is_abstract(Dog));
print(is_class_public(Dog));

print("--- struct introspection ---");
var p = Point();
p.x = 5;
print(struct_of(p));
print(fields_of(Point));
print(field_type(Point, "x"));

print("--- enum introspection ---");
print(enum_members(Color));
print(enum_value_of(Color, "BLUE"));
print(enum_name_of(Color.RED));
print(enum_by_value(Color, 5));

print("--- function introspection ---");
fn add(a: int, b: int): int { ret a + b }
print(function_arity(add));
print(function_name(add));
print(function_params(add));
print(function_return_type(add));
print(function_is_async(add));
print(function_is_builtin(print));
print(function_is_builtin(add));

print("--- members_of ---");
print(members_of(Dog));

print("--- reflection passed ---");
