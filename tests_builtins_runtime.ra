print("=== RUNTIME / DYNAMIC TESTS ===");

pub class Counter {
    pub var count: int = 0;
    pub fn bump() { self.count = self.count + 1; ret self.count; }
    pub fn reset() { self.count = 0; }
    pub static fn make() { ret Counter(); }
}

fn add(a, b) { ret a + b }
fn greet(name) { ret "hi " + name }

print("--- clone / deep_clone ---");
var l = [1, 2, [3, 4]];
var c1 = clone(l);
var c2 = deep_clone(l);
print(c1);
print(c2);

print("--- equals / compare ---");
print(equals(1, 1));
print(equals("a", "b"));
print(strict_equals(1, "1"));
print(compare(1, 2));
print(compare(2, 1));
print(compare(2, 2));

print("--- hash / identity ---");
print(hash("hello") == hash("hello"));
print(hash("a") != hash("b"));

print("--- scope / lookup ---");
var foo = 42;
print(lookup("foo"));
print(lookup("nonexistent"));
print(exists("foo"));

print("--- call introspection ---");
print(current_function());
print(call_stack());
print(current_file());

print("--- invoke ---");
print(invoke(add, 2, 3));
print(invoke(add, [10, 20]));
print(invoke(greet, "Ra"));

print("--- invoke_method ---");
var counter = Counter();
print(invoke_method(counter, "bump"));
print(invoke_method(counter, "bump"));
print(counter.count);

print("--- invoke_static ---");
var c = invoke_static(Counter, "make");
print(c.count);

print("--- new_instance ---");
var c2x = new_instance(Counter);
print(c2x.count);
c2x.count = 99;
print(c2x.count);

print("--- get/set_field ---");
var p = Counter();
set_field(p, "count", 7);
print(get_field(p, "count"));

print("--- error helpers ---");
try {
    throw_error("custom failure");
} catch (e) {
    print("caught error");
}

print("--- runtime passed ---");
