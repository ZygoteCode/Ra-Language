// Ra Language - operators: arithmetic.
//
// Cases:
//   A1   addition
//   A2   subtraction
//   A3   multiplication
//   A4   integer division
//   A5   modulo
//   A6   power
//   A7   unary minus
//   A8   unary plus
//   A9   float arithmetic
//   A10  mixed int/float promotion
//   A11  negative modulo
//   A12  zero raised to power
//   A13  power by zero
//   A14  division by zero raises

print("=== operators/arithmetic ===");

if (3 + 4) == 7 { print("[A1] OK"); } else { print("[A1] FAIL"); }
if (10 - 4) == 6 { print("[A2] OK"); } else { print("[A2] FAIL"); }
if (3 * 7) == 21 { print("[A3] OK"); } else { print("[A3] FAIL"); }
if (20 / 4) == 5 { print("[A4] OK"); } else { print("[A4] FAIL"); }
if (10 % 3) == 1 { print("[A5] OK"); } else { print("[A5] FAIL"); }
if (2 ^ 8) == 256 { print("[A6] OK"); } else { print("[A6] FAIL " + ((2 ^ 8) as string)); }
if -5 == 0 - 5 { print("[A7] OK"); } else { print("[A7] FAIL"); }
if +5 == 5 { print("[A8] OK"); } else { print("[A8] FAIL"); }

var f = 1.5 + 0.5;
if f == 2.0 { print("[A9] OK"); } else { print("[A9] FAIL " + (f as string)); }

var m = 1 + 0.5;
if m == 1.5 { print("[A10] OK"); } else { print("[A10] FAIL " + (m as string)); }

if (-7 % 3) == -1 or (-7 % 3) == 2 { print("[A11] OK"); } else { print("[A11] FAIL " + ((-7 % 3) as string)); }

if (0 ^ 5) == 0 { print("[A12] OK"); } else { print("[A12] FAIL"); }
if (5 ^ 0) == 1 { print("[A13] OK"); } else { print("[A13] FAIL " + ((5 ^ 0) as string)); }

try {
    var _bad = 10 / 0;
    print("[A14] FAIL: division by zero accepted");
} catch (e) {
    print("[A14] OK");
}

print("=== done ===");
