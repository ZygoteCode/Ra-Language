// Ra Language — ADT + pattern matching + Result regression suite.
//
// Each case prints "[<id>] OK" on success or "[<id>] FAIL: <details>".
//
// Coverage:
//   A1   classic integer enum still works (backward compat)
//   A2   classic explicit values + auto-increment
//   A3   classic enum cast to int
//   B1   variant payload single value
//   B2   variant payload multi value
//   B3   zero-arity + payload mixed
//   B4   variant equality (same variant + payload)
//   B5   variant equality differs by payload
//   B6   ToString includes payload
//   B7   nested ADT (Tree)
//   M1   match wildcard catches all
//   M2   match literal numbers
//   M3   match literal strings
//   M4   match variant with binding
//   M5   match qualified vs unqualified variant
//   M6   match tuple destructuring
//   M7   match list with rest pattern
//   M8   match struct destructuring
//   M9   match guard clause
//   M10  match nested patterns (Result<Option<int>>)
//   M11  match zero-arity variant via qualified path
//   M12  match returns a value (expression position)
//   R1   Result.Ok / Result.Err round-trip
//   R2   `?` unwraps Ok
//   R3   `?` early-returns Err
//   R4   `?` chained
//   R5   Option.Some / Option.None
//   E1   non-exhaustive match emits a static-analyzer warning (only checked via runtime fallthrough)
//   E2   wrong payload arity at construction is a runtime error

print("=== Ra ADT / Match / Result Tests ===");

// -- A1: classic enum -------------------------------------------------------
enum Color { Red, Green, Blue }
let c = Color.Green;
if (c as string) == "Color.Green" { print("[A1] OK"); } else { print("[A1] FAIL " + (c as string)); }

// -- A2: classic enum with explicit values ---------------------------------
enum Status { Active = 1, Banned = 100, Vip }
let st = Status.Vip;
if (st as int) == 101 { print("[A2] OK"); } else { print("[A2] FAIL " + (st as int as string)); }

// -- A3: enum cast to int --------------------------------------------------
let i = Status.Banned as int;
if i == 100 { print("[A3] OK"); } else { print("[A3] FAIL " + (i as string)); }

// -- B1: variant payload single value --------------------------------------
enum Token {
    Identifier(string),
    Number(int),
    Symbol(string, int),
    Eof
}
let tok = Token.Identifier("hello");
if (tok as string) == "Token.Identifier(hello)" { print("[B1] OK"); } else { print("[B1] FAIL " + (tok as string)); }

// -- B2: multi payload -----------------------------------------------------
let sym = Token.Symbol("+", 7);
if (sym as string) == "Token.Symbol(+, 7)" { print("[B2] OK"); } else { print("[B2] FAIL " + (sym as string)); }

// -- B3: zero-arity ---------------------------------------------------------
let eof = Token.Eof;
if (eof as string) == "Token.Eof" { print("[B3] OK"); } else { print("[B3] FAIL " + (eof as string)); }

// -- B4 / B5 -----------------------------------------------------------------
let a = Token.Number(10);
let b = Token.Number(10);
let c2 = Token.Number(11);
if a == b { print("[B4] OK"); } else { print("[B4] FAIL"); }
if a != c2 { print("[B5] OK"); } else { print("[B5] FAIL"); }

// -- B6: ToString -----------------------------------------------------------
let v = Token.Number(42);
if (v as string) == "Token.Number(42)" { print("[B6] OK"); } else { print("[B6] FAIL " + (v as string)); }

// -- B7: nested ADT (tree) -------------------------------------------------
enum Tree {
    Leaf(int),
    Node(Tree, Tree)
}
fn sum_tree(t: Tree): int {
    let s = match t {
        case Leaf(v) -> v
        case Node(l, r) -> sum_tree(l) + sum_tree(r)
    };
    ret s;
}
let tree = Tree.Node(Tree.Leaf(1), Tree.Node(Tree.Leaf(2), Tree.Leaf(3)));
if sum_tree(tree) == 6 { print("[B7] OK"); } else { print("[B7] FAIL " + (sum_tree(tree) as string)); }

// -- M1: wildcard ----------------------------------------------------------
let m1 = match 42 {
    case _ -> "any"
};
if m1 == "any" { print("[M1] OK"); } else { print("[M1] FAIL " + m1); }

// -- M2: literal numbers ---------------------------------------------------
fn classify(n: int): string {
    let r = match n {
        case 0 -> "zero"
        case 1 -> "one"
        case _ -> "other"
    };
    ret r;
}
if classify(0) == "zero" and classify(1) == "one" and classify(99) == "other" {
    print("[M2] OK");
} else {
    print("[M2] FAIL");
}

// -- M3: literal strings ---------------------------------------------------
fn greet(s: string): string {
    let r = match s {
        case "hi" -> "hello"
        case "bye" -> "goodbye"
        case _ -> "?"
    };
    ret r;
}
if greet("hi") == "hello" and greet("bye") == "goodbye" and greet("x") == "?" {
    print("[M3] OK");
} else {
    print("[M3] FAIL");
}

// -- M4: variant + binding -------------------------------------------------
let m4 = match Token.Identifier("zed") {
    case Identifier(name) -> name
    case _ -> "?"
};
if m4 == "zed" { print("[M4] OK"); } else { print("[M4] FAIL " + m4); }

// -- M5: qualified path ----------------------------------------------------
let m5 = match Token.Number(7) {
    case Token.Number(n) -> n * 2
    case _ -> -1
};
if m5 == 14 { print("[M5] OK"); } else { print("[M5] FAIL " + (m5 as string)); }

// -- M6: tuple destructuring -----------------------------------------------
let pair = (3, 4);
let m6 = match pair {
    case (x, y) -> x + y
    case _ -> 0
};
if m6 == 7 { print("[M6] OK"); } else { print("[M6] FAIL " + (m6 as string)); }

// -- M7: list with rest ----------------------------------------------------
let lst = [10, 20, 30, 40, 50];
let m7 = match lst {
    case [head, ..tail] -> head + len(tail)
    case _ -> -1
};
if m7 == 14 { print("[M7] OK"); } else { print("[M7] FAIL " + (m7 as string)); }

// -- M8: struct destructuring (uses an explicit constructor to populate fields,
//        since Ra structs need a `fn StructName(...)` constructor to map
//        named arguments to field values).
struct User {
    pub var name: string;
    pub var age: int;

    fn User(n: string, a: int) {
        self.name = n;
        self.age = a;
    }
}
let u = User("Alice", 30);
let m8 = match u {
    case User { name, age } -> name + ":" + (age as string)
};
if m8 == "Alice:30" { print("[M8] OK"); } else { print("[M8] FAIL " + m8); }

// -- M9: guard clause ------------------------------------------------------
fn pos(n: int): string {
    let r = match n {
        case x if x > 0 -> "positive"
        case 0 -> "zero"
        case _ -> "negative"
    };
    ret r;
}
if pos(5) == "positive" and pos(0) == "zero" and pos(-1) == "negative" {
    print("[M9] OK");
} else {
    print("[M9] FAIL");
}

// -- M10: nested patterns --------------------------------------------------
fn deep_unwrap(r: Result<Option<int>, string>): int {
    let v = match r {
        case Ok(Some(x)) -> x
        case Ok(None) -> -1
        case Err(_) -> -2
    };
    ret v;
}
if deep_unwrap(Result.Ok(Option.Some(99))) == 99 { print("[M10a] OK"); } else { print("[M10a] FAIL"); }
if deep_unwrap(Result.Ok(Option.None)) == -1 { print("[M10b] OK"); } else { print("[M10b] FAIL"); }
if deep_unwrap(Result.Err("x")) == -2 { print("[M10c] OK"); } else { print("[M10c] FAIL"); }

// -- M11: zero-arity variant via path --------------------------------------
let m11 = match Token.Eof {
    case Token.Eof -> "done"
    case _ -> "?"
};
if m11 == "done" { print("[M11] OK"); } else { print("[M11] FAIL " + m11); }

// -- M12: match returns a value --------------------------------------------
let computed = match Token.Number(5) {
    case Number(n) -> n + 1
    case _ -> 0
};
if computed == 6 { print("[M12] OK"); } else { print("[M12] FAIL " + (computed as string)); }

// -- R1: Result construction -----------------------------------------------
let r1ok = Result.Ok(123);
let r1err = Result.Err("nope");
let r1_text = match r1ok { case Ok(v) -> (v as string), case Err(_) -> "" };
let r1e_text = match r1err { case Ok(_) -> "", case Err(e) -> e };
if r1_text == "123" and r1e_text == "nope" { print("[R1] OK"); } else { print("[R1] FAIL " + r1_text + "|" + r1e_text); }

// -- R2 / R3 / R4: ? operator ----------------------------------------------
fn parse_pos(s: string): Result<int, string> {
    let n = s as int;
    if n <= 0 { ret Result.Err("not positive"); }
    ret Result.Ok(n);
}

fn double_pos(s: string): Result<int, string> {
    let v = parse_pos(s)?;
    ret Result.Ok(v * 2);
}

let r2 = double_pos("21");
let r2val = match r2 { case Ok(v) -> v, case Err(_) -> -1 };
if r2val == 42 { print("[R2] OK"); } else { print("[R2] FAIL " + (r2val as string)); }

let r3 = double_pos("-1");
let r3msg = match r3 { case Ok(_) -> "", case Err(e) -> e };
if r3msg == "not positive" { print("[R3] OK"); } else { print("[R3] FAIL " + r3msg); }

fn chain(s: string): Result<int, string> {
    let a = parse_pos(s)?;
    let b = parse_pos((a + 1) as string)?;
    ret Result.Ok(a + b);
}
let r4 = chain("3");
let r4val = match r4 { case Ok(v) -> v, case Err(_) -> -1 };
if r4val == 7 { print("[R4] OK"); } else { print("[R4] FAIL " + (r4val as string)); }

// -- R5: Option ------------------------------------------------------------
fn first_or(lst: list<int>, fallback: int): int {
    let r = match lst {
        case [head, ..rest] -> head
        case _ -> fallback
    };
    ret r;
}
if first_or([7, 8, 9], 0) == 7 and first_or([], 99) == 99 { print("[R5] OK"); } else { print("[R5] FAIL"); }

// -- E2: wrong payload arity at construction --------------------------------
try {
    let bad = Token.Number(1, 2);
    print("[E2] FAIL: too many args accepted");
} catch (e) {
    print("[E2] OK");
}

print("=== Done ===");
